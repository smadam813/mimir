@using Microsoft.Extensions.Options
@using Mimir.Server.Configuration
@using Mimir.Server.Storage.Entities
@using Mimir.Server.Ui
@implements IDisposable
@inject InjectionBrowser Browser
@inject SurfaceSearch Search
@inject IOptions<RecallOptions> Recall

@* Spec §8.3, on the Nocturne look (#96): the four-pane surface a curator judges Recall from — a
   session-grouped list, the payload the session actually received, and this Project's §9 figures
   down the side. The mark is per entry, and the screen says so. *@
<div class="surface-panes">

    <div class="pane-list">
        <div class="pane-list-head">
            <div class="pane-list-title">
                <h4>Injections</h4>
                <span class="pane-count">@(_view?.TotalEntries.ToString("N0") ?? "—") entries</span>
            </div>
            <div class="lane-chips">
                <button class="btn btn-secondary lane-chip @(_lane is null ? "is-active" : null)"
                        title="Every lane"
                        @onclick="() => FilterLaneAsync(null)">All</button>
                @foreach (var lane in _view?.Lanes ?? [])
                {
                    <button class="btn btn-secondary lane-chip @(_lane == lane.Lane ? "is-active" : null)"
                            @key="lane.Lane"
                            @onclick="() => FilterLaneAsync(lane.Lane)">
                        @InjectionDisplay.Name(lane.Lane)
                        <span class="lane-chip-count">@lane.Entries</span>
                    </button>
                }
            </div>
        </div>

        <div class="pane-list-body">
            @if (_view is { } view)
            {
                @foreach (var session in view.Sessions)
                {
                    <div class="session-head" @key="session.SessionId">
                        <span class="session-word">Session</span>
                        <span class="session-id" title="Claude Code's own session id">@session.SessionId</span>
                    </div>

                    @foreach (var entry in session.Entries)
                    {
                        <button class="entry-row @(_selected?.Id == entry.Id ? "is-selected" : null)"
                                @key="entry.Id"
                                @onclick="() => Select(entry)">
                            <span class="entry-head">
                                <span class="entry-time">@InjectionDisplay.TimeOfDay(entry.At)</span>
                                <span class="entry-lane">@InjectionDisplay.Name(entry.Lane)</span>
                                @if (entry.Verdict is { } verdict)
                                {
                                    <span class="entry-mark mark-@verdict.ToString().ToLowerInvariant()">
                                        @verdict.ToString().ToLowerInvariant()
                                    </span>
                                }
                                @if (entry.WisdomSinceDeleted is > 0)
                                {
                                    <span class="entry-mark mark-gone"
                                          title="Carried Wisdom hard-deleted since (§10)">
                                        @entry.WisdomSinceDeleted since deleted
                                    </span>
                                }
                                <span class="entry-size">
                                    @entry.Items.Count Wisdom · @entry.Chars.ToString("N0") chars
                                </span>
                            </span>
                            <span class="entry-query">
                                @(entry.QueryContext is { } query
                                    ? $"“{query}”"
                                    : "No query — a Brief carries none.")
                            </span>
                        </button>
                    }
                }

                @if (view.Listed == 0)
                {
                    <p class="pane-empty">
                        @(view.TotalEntries == 0
                            ? "No injections recorded for this Project yet. The Recall lanes fill this"
                              + " surface as sessions run (§7) — and an empty decision leaves no trace,"
                              + " so only actual injections land here."
                            : "No entry matches. Search reads an entry's query text, which a Brief"
                              + " never has (§3).")
                    </p>
                }
                else if (view.Truncated)
                {
                    <p class="pane-truncated">
                        @(view.Matching - view.Listed) more · older entries fall off at
                        @InjectionBrowser.RecentEntryLimit
                    </p>
                }
            }
        </div>
    </div>

    <div class="pane-detail-frame">
        @if (_selected is { } selected)
        {
            <InjectionDetail Entry="selected" ProjectId="ProjectId" Options="Recall.Value"
                             OnMark="MarkAsync" OnPromote="PromoteAsync" />
        }
        else
        {
            <main class="pane-detail">
                <div class="pane-detail-body">
                    <p class="pane-placeholder">
                        Pick an entry to read the payload its session received, and the score that
                        put each line there.
                    </p>
                </div>
            </main>
        }

        <aside class="pane-aside">
            @if (_view is { } stats)
            {
                <div>
                    <h6>This Project</h6>
                    <div class="aside-figure">
                        <span class="aside-figure-value">@stats.TotalEntries.ToString("N0")</span>
                        <span class="aside-figure-unit">
                            entries, @stats.TotalSessions.ToString("N0")
                            @(stats.TotalSessions == 1 ? "session" : "sessions")
                        </span>
                    </div>
                    <dl class="aside-rows">
                        <dt>Marked useful</dt><dd class="is-accent">@stats.Useful.ToString("N0")</dd>
                        <dt>Marked noise</dt><dd>@stats.Noise.ToString("N0")</dd>
                        <dt>Unmarked</dt><dd class="is-strong">@stats.Unmarked.ToString("N0")</dd>
                        <dt>Injection precision</dt>
                        <dd class="is-strong">
                            @(stats.Precision is { } precision ? precision.ToString("0.00") : "—")
                        </dd>
                    </dl>
                    <p class="aside-note">
                        @(stats.Precision is null
                            ? "Precision is useful ÷ marked (§9) — nothing is marked yet, so there is"
                              + " no figure to show."
                            : $"Precision is useful ÷ marked over the whole history — the"
                              + $" {InjectionBrowser.RecentEntryLimit}-entry listing bound never moves it.")
                    </p>
                </div>

                <div>
                    <h6>Most recalled this week</h6>
                    @if (stats.MostRecalledThisWeek.Count == 0)
                    {
                        <p class="aside-note">Nothing was recalled in the last seven days.</p>
                    }
                    else
                    {
                        <div class="aside-links">
                            @foreach (var recalled in stats.MostRecalledThisWeek)
                            {
                                @if (recalled.Wisdom is { } wisdom)
                                {
                                    <a class="aside-link" @key="recalled.WisdomId"
                                       href="@($"projects/{ProjectId}/wisdom/{recalled.WisdomId}")">
                                        <span class="aside-link-text">@wisdom.Text</span>
                                        <span class="aside-link-count">@recalled.Recalls</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="aside-link is-gone" @key="recalled.WisdomId">
                                        <span class="aside-link-text">A Wisdom deleted since (§10)</span>
                                        <span class="aside-link-count">@recalled.Recalls</span>
                                    </span>
                                }
                            }
                        </div>
                    }
                </div>

                <div>
                    <h6>Promoted to golden</h6>
                    <div class="aside-figure">
                        <span class="aside-figure-value">@stats.PromotedCases.ToString("N0")</span>
                        <span class="aside-figure-unit">
                            @(stats.PromotedCases == 1 ? "case" : "cases"),
                            from @stats.TotalEntries.ToString("N0") entries
                        </span>
                    </div>
                    <p class="aside-note">
                        A case replays the entry's query and expects its top still-live Wisdom. One
                        case per entry — a repeat click returns the same one.
                    </p>
                </div>
            }
        </aside>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Guid ProjectId { get; set; }

    private InjectionLogView? _view;
    private InjectionLogEntry? _selected;
    private InjectionLane? _lane;
    private string? _search;
    private IDisposable? _searchClaim;
    private Guid _loadedProject;

    protected override async Task OnParametersSetAsync()
    {
        // A different Project is a different log: the lane chip and the term were chosen against
        // the old one's counts, and the selected entry is not in the new one at all. The router
        // reuses this instance across the switch — same route template, different parameter — so
        // this is the only place that runs, and claiming in OnInitialized would leave the header
        // still showing the term the previous Project's list was narrowed by.
        if (_loadedProject != ProjectId)
        {
            _loadedProject = ProjectId;
            (_lane, _search, _selected) = (null, null, null);
            _searchClaim?.Dispose();
            _searchClaim = Search.Claim("Search this Project's injections…", OnSearchAsync);
        }

        await RefreshAsync();
    }

    private void Select(InjectionLogEntry entry) => _selected = entry;

    private async Task FilterLaneAsync(InjectionLane? lane)
    {
        _lane = lane;
        await RefreshAsync();
    }

    private async Task OnSearchAsync(string term)
    {
        _search = term;
        await RefreshAsync();
        StateHasChanged();
    }

    private async Task MarkAsync(InjectionVerdict verdict)
    {
        if (_selected is { } entry)
        {
            await Browser.MarkAsync(entry.Id, verdict, CancellationToken.None);
            await RefreshAsync();
        }
    }

    private async Task PromoteAsync()
    {
        if (_selected is { } entry)
        {
            await Browser.PromoteAsync(entry.Id, CancellationToken.None);
            await RefreshAsync();
        }
    }

    private async Task RefreshAsync()
    {
        _view = await Browser.ListAsync(
            new InjectionQuery(ProjectId, _search, _lane), CancellationToken.None);

        // The entries are records read fresh each time, so the selection has to be re-resolved by
        // id or a mark would show its old verdict until the curator clicked elsewhere. An entry
        // filtered or truncated out of the listing drops the selection with it.
        _selected = _selected is { } previous
            ? _view.Sessions.SelectMany(s => s.Entries).FirstOrDefault(e => e.Id == previous.Id)
            : null;
    }

    public void Dispose() => _searchClaim?.Dispose();
}
