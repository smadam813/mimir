@using Mimir.Server.Capture
@using Mimir.Server.Components.Health
@using Mimir.Server.Ui
@implements IDisposable
@inject ChassisBrowser Browser
@inject IEpisodeFeed Feed
@inject SurfaceSearch Search
@inject ILogger<AppHeader> Logger

@* Spec §8: brand, search, the whole-install pipeline readout, and the Health pill. The header is
   whole-install; the tab strip beneath it answers the selected-Project question instead (#89). *@
<header class="app-header">
    <a class="app-brand" href="/">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-word">Mimir</span>
    </a>

    @* One box for every surface: whichever is mounted claims it and narrows its own list (#94).
       Unclaimed — an unported surface, or Global's Episodes tab — it renders disabled and says so. *@
    <label class="app-search">
        <svg width="14" height="14" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
            <path d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z" />
        </svg>
        <input class="input" disabled="@(!Search.IsClaimed)"
               placeholder="@(Search.Placeholder ?? "Search")"
               title="@(Search.IsClaimed
                   ? null
                   : "Nothing here claims search — it narrows whichever list is on screen.")"
               value="@_searchText"
               @oninput="OnSearchInput" />
    </label>

    <span class="app-header-spacer"></span>

    @if (_pipeline is { } pipeline)
    {
        <div class="pipeline"
             title="The pipeline, live: Episodes captured → Sealed Episodes still owed distillation, failed included → Wisdom admitted → Injections recalled today">
            <span class="pipeline-stat">
                <span class="pipeline-value">@pipeline.Episodes.ToString("N0")</span>
                <span class="pipeline-label">Episodes</span>
            </span>
            <span class="pipeline-rule" aria-hidden="true"></span>
            <span class="pipeline-stat">
                <span class="pipeline-value-row">
                    <span class="pipeline-value @(pipeline.Distilling ? "is-active" : null)">
                        @pipeline.Queued.ToString("N0")
                    </span>
                    @if (pipeline.Distilling)
                    {
                        <span class="pipeline-pulse" aria-hidden="true"></span>
                    }
                </span>
                <span class="pipeline-label">Queued</span>
            </span>
            <span class="pipeline-rule" aria-hidden="true"></span>
            <span class="pipeline-stat">
                <span class="pipeline-value">@pipeline.Wisdom.ToString("N0")</span>
                <span class="pipeline-label">Wisdom</span>
            </span>
            <span class="pipeline-rule" aria-hidden="true"></span>
            <span class="pipeline-stat">
                <span class="pipeline-value">@pipeline.RecalledToday.ToString("N0")</span>
                <span class="pipeline-label">Recalled</span>
            </span>
        </div>
    }

    <HealthPill />
</header>

@code {
    private static readonly TimeSpan DebounceDelay = TimeSpan.FromMilliseconds(250);

    private HeaderPipeline? _pipeline;
    private IDisposable? _subscription;
    private CancellationTokenSource? _debounce;
    private int _generation;

    /// <summary>Serialises <see cref="ScheduleRefresh"/> against <see cref="Dispose"/>.</summary>
    private readonly Lock _debounceGate = new();

    private bool _disposed;

    /// <summary>
    /// Bumped on every handover, so a keystroke that outlived its surface can be recognised and
    /// dropped. Read and written only on the circuit's dispatcher, which is where both the handover
    /// and the debounce's delivery land.
    /// </summary>
    private int _claimGeneration;

    /// <summary>
    /// What is in the box right now, updated on every keystroke — the claimant only hears the term
    /// once typing settles, and re-rendering the input against its debounced value would snap the
    /// caret back to what the curator had typed a moment ago.
    /// </summary>
    private string _searchText = string.Empty;

    private CancellationTokenSource? _searchDebounce;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        // A surface claiming or releasing the box enables or disables it, and drops whatever the
        // last surface's search left in it.
        Search.ClaimChanged += OnClaimChanged;

        // The Episode feed is the only signal that already exists for these figures (#89); it
        // fires on every captured Event, not only session start and Seal, so a burst (a tool use
        // with the header mounted on several tabs) is coalesced into one refresh instead of one
        // five-query round trip per Event.
        _subscription = Feed.Subscribe(change => ScheduleRefresh());
    }

    private void OnClaimChanged()
    {
        // The pending keystroke belongs to the surface that just left: delivering it after the
        // handover would narrow the incoming surface by a term the box no longer shows. Cancelling
        // catches it while it is still waiting out the debounce; the generation catches it once the
        // wait has elapsed and only the delivery is queued, where a cancel is a no-op.
        _claimGeneration++;
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
        _searchDebounce = null;
        _searchText = string.Empty;
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Debounced the way the pipeline's refresh is: a keystroke narrows a list with a database
    /// query behind it, so the claimant hears the term once typing settles rather than per letter.
    /// </summary>
    private void OnSearchInput(ChangeEventArgs args)
    {
        _searchText = args.Value?.ToString() ?? string.Empty;
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
        var cts = new CancellationTokenSource();
        _searchDebounce = cts;
        _ = DebouncedSearchAsync(_searchText, _claimGeneration, cts.Token);
    }

    private async Task DebouncedSearchAsync(
        string term, int claimGeneration, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(DebounceDelay, cancellationToken);

            // Checked on the dispatcher, alongside the delivery it guards: a handover processed
            // between the delay elapsing and this running must still shed the term.
            await InvokeAsync(() => claimGeneration == _claimGeneration
                ? Search.EnterAsync(term)
                : Task.CompletedTask);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a later keystroke before the debounce elapsed.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Narrowing the active surface by \"{Term}\" failed", term);
        }
    }

    /// <summary>
    /// Coalesces a burst into one refresh. Guarded, because the feed publishes on whichever thread
    /// captured — not this circuit's dispatcher — so this runs concurrently with <see cref="Dispose"/>
    /// reaching for the same field. Unguarded, a change landing mid-teardown installs a fresh
    /// timer nobody will ever cancel, and it fires against a disposed component 250 ms later.
    /// </summary>
    private void ScheduleRefresh()
    {
        CancellationTokenSource cts;
        lock (_debounceGate)
        {
            if (_disposed)
            {
                return;
            }

            _debounce?.Cancel();
            _debounce?.Dispose();
            cts = new CancellationTokenSource();
            _debounce = cts;
        }

        _ = DebouncedRefreshAsync(cts.Token);
    }

    private async Task DebouncedRefreshAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(DebounceDelay, cancellationToken);
            await InvokeAsync(RefreshAsync);
        }
        catch (OperationCanceledException)
        {
            // Superseded by a later Event before the debounce elapsed.
        }
        catch (Exception ex)
        {
            // Fire-and-forget from the feed callback: without this, a transient Postgres failure
            // here is a silently swallowed exception rather than a stale-but-visible header.
            Logger.LogWarning(ex, "Header pipeline refresh failed");
        }
    }

    private async Task RefreshAsync()
    {
        var generation = ++_generation;

        var pipeline = await Browser.GetHeaderPipelineAsync(CancellationToken.None);

        // Two changes landing a debounce apart both reach here, and cancelling an elapsed delay is
        // a no-op — so whichever query returns second must not be the one that wins. The feed
        // delivers in bursts by design (§8), which makes overlapping queries the ordinary case.
        if (generation != _generation)
        {
            return;
        }

        _pipeline = pipeline;
        StateHasChanged();
    }

    public void Dispose()
    {
        Search.ClaimChanged -= OnClaimChanged;
        _subscription?.Dispose();
        lock (_debounceGate)
        {
            _disposed = true;
            _debounce?.Cancel();
            _debounce?.Dispose();
        }

        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
    }
}
