@using Mimir.Server.Capture
@using Mimir.Server.Components.Health
@using Mimir.Server.Ui
@implements IDisposable
@inject ChassisBrowser Browser
@inject IEpisodeFeed Feed
@inject SurfaceSearch Search
@inject ILogger<AppHeader> Logger

@* Spec §8: brand, search, the whole-install pipeline readout, and the Health pill. The header is
   whole-install; the tab strip beneath it answers the selected-Project question instead (#89). *@
<header class="app-header">
    <a class="app-brand" href="/">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-word">Mimir</span>
    </a>

    <label class="app-search">
        <svg width="14" height="14" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
            <path d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z" />
        </svg>
        @* One box, whichever surface owns it: the active surface claims it on mount with its own
           wording and receives the term (#89, #96). Disabled until one does.

           Keyed on the claim's generation and carrying no `value`: the header must never write back
           into a box the curator is typing in — with a value bound, the debounced round trip lands
           a render mid-word and the caret jumps. A new element is therefore the only way to empty
           it, and a new claim is the only thing that should, because a term typed at one surface
           means nothing at the next. Keyed on the generation rather than the wording, since the
           same tab on a second Project claims it under the same words. *@
        <input class="input" @key="Search.Generation"
               disabled="@(!Search.IsClaimed)"
               placeholder="@(Search.Placeholder ?? UnclaimedPlaceholder)"
               title="@(Search.IsClaimed
                   ? null
                   : "No surface has claimed search yet — it narrows the active tab once a surface is ported.")"
               @oninput="OnSearchInput" />
    </label>

    <span class="app-header-spacer"></span>

    @if (_pipeline is { } pipeline)
    {
        <div class="pipeline"
             title="The pipeline, live: Episodes captured → Sealed Episodes still owed distillation, failed included → Wisdom admitted → Injections recalled today">
            <span class="pipeline-stat">
                <span class="pipeline-value">@pipeline.Episodes.ToString("N0")</span>
                <span class="pipeline-label">Episodes</span>
            </span>
            <span class="pipeline-rule" aria-hidden="true"></span>
            <span class="pipeline-stat">
                <span class="pipeline-value-row">
                    <span class="pipeline-value @(pipeline.Distilling ? "is-active" : null)">
                        @pipeline.Queued.ToString("N0")
                    </span>
                    @if (pipeline.Distilling)
                    {
                        <span class="pipeline-pulse" aria-hidden="true"></span>
                    }
                </span>
                <span class="pipeline-label">Queued</span>
            </span>
            <span class="pipeline-rule" aria-hidden="true"></span>
            <span class="pipeline-stat">
                <span class="pipeline-value">@pipeline.Wisdom.ToString("N0")</span>
                <span class="pipeline-label">Wisdom</span>
            </span>
            <span class="pipeline-rule" aria-hidden="true"></span>
            <span class="pipeline-stat">
                <span class="pipeline-value">@pipeline.RecalledToday.ToString("N0")</span>
                <span class="pipeline-label">Recalled</span>
            </span>
        </div>
    }

    <HealthPill />
</header>

@code {
    private static readonly TimeSpan DebounceDelay = TimeSpan.FromMilliseconds(250);

    /// <summary>What the box says while no surface owns it — also its @key in that state.</summary>
    private const string UnclaimedPlaceholder = "Search all Wisdom and Episodes…";

    private HeaderPipeline? _pipeline;
    private IDisposable? _subscription;
    private Debouncer? _refreshDebounce;
    private Debouncer? _searchDebounce;

    /// <summary>
    /// Synchronous, and deliberately not folded into <see cref="OnInitializedAsync"/>: a surface
    /// claims the box as it mounts, and the first <c>await</c> there yields long enough for the
    /// claim to land before the subscription would exist to hear it.
    /// </summary>
    protected override void OnInitialized()
    {
        _refreshDebounce = new Debouncer(DebounceDelay, Logger, "Header pipeline refresh");
        _searchDebounce = new Debouncer(DebounceDelay, Logger, "Surface search");
        Search.Changed += OnSearchChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        // The Episode feed is the only signal that already exists for these figures (#89); it
        // fires on every captured Event, not only session start and Seal, so a burst (a tool use
        // with the header mounted on several tabs) is coalesced into one refresh instead of one
        // five-query round trip per Event.
        _subscription = Feed.Subscribe(
            change => _refreshDebounce?.Schedule(() => InvokeAsync(RefreshAsync)));
    }

    private async Task RefreshAsync()
    {
        _pipeline = await Browser.GetHeaderPipelineAsync(CancellationToken.None);
        StateHasChanged();
    }

    /// <summary>
    /// Debounced on the way out only: the box itself is uncontrolled, so what was typed is on
    /// screen the instant it is typed, while the surface behind it is spared a query per character.
    /// </summary>
    private void OnSearchInput(ChangeEventArgs e)
    {
        // Both are read here, at the keystroke, not after the delay. The generation is what tells
        // SurfaceSearch whether the surface being typed at is still the one that will receive this
        // term — nothing here cancels on a claim change, so a Project switched inside the window
        // leaves this timer running with the old surface's word in it.
        var term = e.Value?.ToString() ?? "";
        var generation = Search.Generation;
        _searchDebounce?.Schedule(() => InvokeAsync(() => Search.SetTermAsync(term, generation)));
    }

    /// <summary>A claim, a release, or the term the surface actually received.</summary>
    private void OnSearchChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _subscription?.Dispose();
        Search.Changed -= OnSearchChanged;
        _refreshDebounce?.Dispose();
        _searchDebounce?.Dispose();
    }
}
