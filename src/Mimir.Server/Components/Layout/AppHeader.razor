@using Mimir.Server.Capture
@using Mimir.Server.Components.Health
@using Mimir.Server.Ui
@implements IDisposable
@inject ChassisBrowser Browser
@inject IEpisodeFeed Feed
@inject SurfaceSearch Search
@inject ILogger<AppHeader> Logger

<header class="app-header">
    <a class="app-brand" href="/">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-word">Mimir</span>
    </a>

    <label class="app-search">
        <svg width="14" height="14" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
            <path d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z" />
        </svg>
        <input class="input" aria-label="Search"
               placeholder="@(Search.Placeholder ?? "Search…")"
               disabled="@(!Search.IsClaimed)"
               title="@(Search.IsClaimed ? null : "Nothing here claims search — it narrows whichever surface's list is on screen, and this screen has none.")"
               value="@Search.Term" @oninput="OnSearchInput" />
    </label>

    <span class="app-header-spacer"></span>

    @if (IsFirstRun is true)
    {
        <ModelPullChip />
    }
    else if (_pipeline is { } pipeline)
    {
        <div class="pipeline"
             title="The pipeline, live: Episodes captured → Sealed Episodes still owed distillation, failed included → Wisdom admitted → Injections recalled today">
            <span class="pipeline-stat">
                <span class="pipeline-value">@pipeline.Episodes.ToString("N0")</span>
                <span class="pipeline-label">Episodes</span>
            </span>
            <span class="pipeline-rule" aria-hidden="true"></span>
            <span class="pipeline-stat">
                <span class="pipeline-value-row">
                    <span class="pipeline-value @(pipeline.Distilling ? "is-active" : null)">
                        @pipeline.Queued.ToString("N0")
                    </span>
                    @if (pipeline.Distilling)
                    {
                        <span class="pipeline-pulse" aria-hidden="true"></span>
                    }
                </span>
                <span class="pipeline-label">Queued</span>
            </span>
            <span class="pipeline-rule" aria-hidden="true"></span>
            <span class="pipeline-stat">
                <span class="pipeline-value">@pipeline.Wisdom.ToString("N0")</span>
                <span class="pipeline-label">Wisdom</span>
            </span>
            <span class="pipeline-rule" aria-hidden="true"></span>
            <span class="pipeline-stat">
                <span class="pipeline-value">@pipeline.RecalledToday.ToString("N0")</span>
                <span class="pipeline-label">Recalled</span>
            </span>
        </div>
    }

    <HealthPill />
</header>

@code {
    [CascadingParameter(Name = MainLayout.FirstRunCascade)]
    public bool? IsFirstRun { get; set; }

    private HeaderPipeline? _pipeline;
    private IDisposable? _subscription;
    private Debouncer? _debounce;
    private int _generation;

    protected override void OnInitialized()
    {
        _debounce = new Debouncer(
            Debouncer.DefaultDelay, Logger, "Header pipeline refresh", Debouncer.DefaultCeilingMultiple);
        Search.Changed += OnSearchChanged;
        _subscription = Feed.Subscribe(change => _debounce?.Schedule(() => InvokeAsync(RefreshAsync)));
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsFirstRun is false && _pipeline is null)
        {
            await RefreshAsync();
        }
    }

    private async Task RefreshAsync()
    {
        if (IsFirstRun is not false)
        {
            return;
        }

        var generation = ++_generation;

        var pipeline = await Browser.GetHeaderPipelineAsync(CancellationToken.None);

        if (generation != _generation)
        {
            return;
        }

        _pipeline = pipeline;
        StateHasChanged();
    }

    private void OnSearchInput(ChangeEventArgs args) => Search.Set(args.Value as string);

    private void OnSearchChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Search.Changed -= OnSearchChanged;
        _subscription?.Dispose();
        _debounce?.Dispose();
    }
}
