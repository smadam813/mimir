@using Mimir.Server.Capture
@using Mimir.Server.Components.FirstRun
@using Mimir.Server.Ui
@inherits LayoutComponentBase
@implements IDisposable
@inject ChassisBrowser Browser
@inject IEpisodeFeed Feed
@inject NavigationManager Nav
@inject ILogger<MainLayout> Logger

@* Spec §8: the chassis every surface lives in — header, tab strip, sidebar, then whichever
   surface's body @Body renders. Fixed desktop frame: the whole shell fills the viewport and each
   pane scrolls on its own, with a 1380px floor below which the frame scrolls horizontally rather
   than reflowing (#89).

   An install that has never been introduced to Claude Code is a state of this same shell, not a
   separate screen (#90): the tab strip goes (there is no Project to count anything for), the body
   explains the two registrations, and the header and sidebar read the cascade to say their own
   part. Every region reads one flag from here rather than asking the database itself. *@
<CascadingValue Value="IsFirstRun" Name="@FirstRunCascade">
    <div class="app-frame">
        <AppHeader />
        @if (!ShowFirstRun)
        {
            <SurfaceTabStrip />
        }
        <div class="app-row">
            <ProjectSidebar />
            <main class="app-body @BodyFit">
                @if (ShowFirstRun)
                {
                    <FirstRunPanel />
                }
                else
                {
                    @Body
                }
            </main>
        </div>
    </div>
</CascadingValue>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    /// <summary>
    /// The name the header's and the sidebar's <c>[CascadingParameter]</c> bind to. One constant
    /// rather than the same string literal in three files. What it carries is nullable: null is
    /// "no answer yet", which the shell renders as the populated chassis but neither consumer
    /// treats as a fact worth querying for.
    /// </summary>
    public const string FirstRunCascade = "IsFirstRun";

    /// <summary>
    /// Whether this install has never been introduced to Claude Code — carried across the
    /// prerender/circuit boundary rather than asked twice. Null until the first answer lands, and
    /// again on a page whose prerender pass could not reach Postgres, which the circuit then
    /// retries; an unknown answer shows the populated chassis, the state that asks nothing.
    /// </summary>
    /// <remarks>
    /// Public and settable because that is the shape <c>[PersistentState]</c> binds to, and
    /// persisted because without it the interactive instance starts at the default, renders once
    /// before its own query resolves, and flashes the populated chassis over the prerendered
    /// onboarding body on every first-run load — the one thing #90 is about.
    /// </remarks>
    [PersistentState]
    public bool? IsFirstRun { get; set; }

    private bool ShowFirstRun => IsFirstRun is true;

    /// <summary>
    /// How the body sits in the frame. First run draws its own padding and accent wash to the
    /// pane's edges (#90); otherwise a ported surface fills the body flush and scrolls its own
    /// panes, while every surface still on the old stylesheet keeps the padded, single-scroll body
    /// the frame used to give all of them (#91). The two never apply at once — first run replaces
    /// <c>Body</c> outright, so no surface is rendering to be flush.
    /// </summary>
    private string? BodyFit => ShowFirstRun
        ? "is-bare"
        : IsPortedSurface ? "is-flush" : null;

    /// <summary>
    /// Read from the URL, the same way the sidebar and tab strip read it (#89); the layout
    /// re-renders on every navigation because the router hands it a fresh <c>Body</c>. Each of
    /// #94–#96 adds its own surface here; the branch goes with the old stylesheet (#97).
    /// </summary>
    private bool IsPortedSurface
        => ProjectRoute.Parse(Nav.ToBaseRelativePath(Nav.Uri))?.Tab == "wisdom";

    private IDisposable? _subscription;
    private bool _rechecking;
    private bool _recheckAgain;

    protected override async Task OnInitializedAsync()
    {
        if (IsFirstRun is null)
        {
            try
            {
                IsFirstRun = await Browser.IsFirstRunAsync(CancellationToken.None);
            }
            catch (Exception ex)
            {
                // The chassis renders either way: nothing here is worth the whole shell becoming
                // Blazor's error banner while the compose stack is still settling. Left unset
                // rather than false, so the interactive pass asks again instead of inheriting a
                // failure the prerender pass happened to hit.
                Logger.LogWarning(ex, "First-run check failed");
            }
        }

        if (ShowFirstRun)
        {
            // A one-way latch: first run is "no non-Global Project exists", and a Project is only
            // ever created — so the shell watches the Episode feed only while it is still showing
            // the first-run state, and stops for good the moment the first hook lands. No debounce,
            // unlike AppHeader's and ProjectSidebar's own refreshes: the very first Event to arrive
            // is normally the one that ends the watch, and delaying that is delaying the whole
            // point. RecheckAsync coalesces a burst instead.
            _subscription = Feed.Subscribe(change => _ = InvokeAsync(RecheckAsync));
        }
    }

    private async Task RecheckAsync()
    {
        if (!ShowFirstRun)
        {
            return;
        }

        if (_rechecking)
        {
            // An Event landed while the last query was in flight. That query may have read the
            // database before this Event's own write committed, so ask once more when it returns
            // rather than either racing a second query alongside it or dropping the Event.
            _recheckAgain = true;
            return;
        }

        _rechecking = true;
        try
        {
            do
            {
                _recheckAgain = false;
                IsFirstRun = await Browser.IsFirstRunAsync(CancellationToken.None);
            }
            while (ShowFirstRun && _recheckAgain);

            if (!ShowFirstRun)
            {
                _subscription?.Dispose();
                _subscription = null;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            // Fire-and-forget from the feed callback, and the whole body is inside this: a
            // transient Postgres failure, or a StateHasChanged against a circuit torn down while
            // the query was in flight, would otherwise be an exception nobody ever observes.
            Logger.LogWarning(ex, "First-run check failed");
        }
        finally
        {
            _rechecking = false;
        }
    }

    public void Dispose() => _subscription?.Dispose();
}
