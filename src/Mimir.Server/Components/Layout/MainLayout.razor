@inherits LayoutComponentBase

@* Spec §8: the chassis every surface lives in — header, tab strip, sidebar, then whichever
   surface's body @Body renders. Fixed desktop frame: the whole shell fills the viewport and each
   pane scrolls on its own, with a 1380px floor below which the frame scrolls horizontally rather
   than reflowing (#89). *@
<div class="app-frame">
    <AppHeader />
    <SurfaceTabStrip />
    <div class="app-row">
        <ProjectSidebar />
        <main class="app-body">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
