@using Mimir.Server.Capture
@using Mimir.Server.Components.FirstRun
@using Mimir.Server.Ui
@inherits LayoutComponentBase
@implements IDisposable
@inject ChassisBrowser Browser
@inject IEpisodeFeed Feed
@inject NavigationManager Nav
@inject ILogger<MainLayout> Logger

<CascadingValue Value="IsFirstRun" Name="@FirstRunCascade">
    <div class="app-frame">
        <AppHeader />
        @if (!ShowFirstRun)
        {
            <SurfaceTabStrip />
        }
        <div class="app-row">
            <ProjectSidebar />
            <main class="app-body @BodyFit">
                @if (ShowFirstRun)
                {
                    <FirstRunPanel />
                }
                else
                {
                    @Body
                }
            </main>
        </div>
    </div>
</CascadingValue>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    public const string FirstRunCascade = "IsFirstRun";

    // Public and settable because that is the shape [PersistentState] binds to.
    [PersistentState]
    public bool? IsFirstRun { get; set; }

    private bool ShowFirstRun => IsFirstRun is true;

    private string? BodyFit => !ShowFirstRun && ProjectRoute.Parse(Nav.ToBaseRelativePath(Nav.Uri)) is not null
        ? "is-flush"
        : null;

    private IDisposable? _subscription;
    private bool _rechecking;
    private bool _recheckAgain;

    protected override async Task OnInitializedAsync()
    {
        if (IsFirstRun is null)
        {
            try
            {
                IsFirstRun = await Browser.IsFirstRunAsync(CancellationToken.None);
            }
            catch (Exception ex)
            {
                // Swallowed and left unset: the chassis renders either way, and nothing here is
                // worth the whole shell becoming Blazor's error banner mid-boot.
                Logger.LogWarning(ex, "First-run check failed");
            }
        }

        if (ShowFirstRun)
        {
            _subscription = Feed.Subscribe(change => _ = InvokeAsync(RecheckAsync));
        }
    }

    private async Task RecheckAsync()
    {
        if (!ShowFirstRun)
        {
            return;
        }

        if (_rechecking)
        {
            _recheckAgain = true;
            return;
        }

        _rechecking = true;
        try
        {
            do
            {
                _recheckAgain = false;
                IsFirstRun = await Browser.IsFirstRunAsync(CancellationToken.None);
            }
            while (ShowFirstRun && _recheckAgain);

            if (!ShowFirstRun)
            {
                _subscription?.Dispose();
                _subscription = null;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            // Swallowed because the caller is a fire-and-forget feed callback: anything thrown
            // here — a transient Postgres failure, a torn-down circuit — is never observed.
            Logger.LogWarning(ex, "First-run check failed");
        }
        finally
        {
            _rechecking = false;
        }
    }

    public void Dispose() => _subscription?.Dispose();
}
