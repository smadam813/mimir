@using Mimir.Server.Capture
@using Mimir.Server.Components.Wisdom
@using Mimir.Server.Ui
@implements IDisposable
@inject ChassisBrowser Browser
@inject IEpisodeFeed Feed
@inject NavigationManager Nav
@inject ILogger<ProjectSidebar> Logger

<nav class="project-sidebar" aria-label="Projects">
    <h6 class="sidebar-heading">Projects</h6>
    <div class="sidebar-group">
        @foreach (var project in _projects)
        {
            <a class="sidebar-item @(IsSelectedProject(project.Id) ? "is-selected" : null)"
               href="@($"projects/{project.Id}/episodes")">
                <span class="sidebar-item-name">@project.DisplayName</span>
                <span class="sidebar-item-count">@project.WisdomCount</span>
            </a>
        }
    </div>

    @if (IsFirstRun is true)
    {
        <p class="sidebar-note">
            Projects appear here on their session's first hook — nothing to configure.
        </p>
        <div class="sidebar-waiting" aria-hidden="true">
            <span class="sidebar-waiting-bar"></span>
            <span class="sidebar-waiting-bar"></span>
            <span class="sidebar-waiting-bar"></span>
        </div>
    }
    else if (_activeTab is { } tab && _activeProject is { } projectId)
    {
        <h6 class="sidebar-heading">@GroupTitle(tab)</h6>
        <div class="sidebar-group">
            @switch (tab)
            {
                case "wisdom":
                    <a class="sidebar-item @(IsLens(WisdomLens.Contested) ? "is-selected" : null)"
                       href="@LensHref(projectId, WisdomLens.Contested)">
                        <span class="attention-dot dot-accent"></span>
                        <span class="sidebar-item-name">Contested</span>
                        <span class="sidebar-item-count count-accent">@(_wisdomAttention?.Contested ?? 0)</span>
                    </a>
                    <a class="sidebar-item @(IsLens(WisdomLens.Orphaned) ? "is-selected" : null)"
                       href="@LensHref(projectId, WisdomLens.Orphaned)">
                        <span class="attention-dot dot-danger"></span>
                        <span class="sidebar-item-name">Orphaned</span>
                        <span class="sidebar-item-count count-danger">@(_wisdomAttention?.Orphaned ?? 0)</span>
                    </a>
                    <a class="sidebar-item @(IsLens(WisdomLens.Retired) ? "is-selected" : null)"
                       href="@LensHref(projectId, WisdomLens.Retired)">
                        <span class="attention-dot dot-neutral"></span>
                        <span class="sidebar-item-name">Retired</span>
                        <span class="sidebar-item-count">@(_wisdomAttention?.Retired ?? 0)</span>
                    </a>
                    break;

                case "injections":
                    <div class="sidebar-item">
                        <span class="attention-dot dot-accent"></span>
                        <span class="sidebar-item-name">Marked useful</span>
                        <span class="sidebar-item-count count-accent">@(_recallAttention?.MarkedUseful ?? 0)</span>
                    </div>
                    <div class="sidebar-item">
                        <span class="attention-dot dot-neutral"></span>
                        <span class="sidebar-item-name">Marked noise</span>
                        <span class="sidebar-item-count">@(_recallAttention?.MarkedNoise ?? 0)</span>
                    </div>
                    <div class="sidebar-item">
                        <span class="attention-dot dot-danger"></span>
                        <span class="sidebar-item-name">Wisdom since deleted</span>
                        <span class="sidebar-item-count count-danger">@(_recallAttention?.WisdomSinceDeleted ?? 0)</span>
                    </div>
                    <p class="sidebar-note">
                        The log is this project's. Global Wisdom answers in any session, labelled
                        Global where it landed.
                    </p>
                    break;

                default:
                    <div class="sidebar-item">
                        <span class="attention-dot dot-accent @(_captureAttention?.Running > 0 ? "is-pulsing" : null)"></span>
                        <span class="sidebar-item-name">Running</span>
                        <span class="sidebar-item-count count-accent">@(_captureAttention?.Running ?? 0)</span>
                    </div>
                    <div class="sidebar-item">
                        <span class="attention-dot dot-danger"></span>
                        <span class="sidebar-item-name">Failed</span>
                        <span class="sidebar-item-count count-danger">@(_captureAttention?.Failed ?? 0)</span>
                    </div>
                    <div class="sidebar-item">
                        <span class="attention-dot dot-neutral"></span>
                        <span class="sidebar-item-name">Queue depth</span>
                        <span class="sidebar-item-count">@(_captureAttention?.QueueDepth ?? 0)</span>
                    </div>
                    break;
            }
        </div>
    }
</nav>

@code {
    [CascadingParameter(Name = MainLayout.FirstRunCascade)]
    public bool? IsFirstRun { get; set; }

    private IReadOnlyList<ProjectListItem> _projects = [];
    private string? _activeTab;
    private Guid? _activeProject;
    private WisdomLens _activeLens;
    private WisdomAttention? _wisdomAttention;
    private CaptureAttention? _captureAttention;
    private RecallAttention? _recallAttention;
    private IDisposable? _subscription;

    private Debouncer? _debounce;

    protected override void OnInitialized()
        => _debounce = new Debouncer(
            Debouncer.DefaultDelay, Logger, "Project sidebar refresh", Debouncer.DefaultCeilingMultiple);

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        _subscription = Feed.Subscribe(
            change => _debounce?.Schedule(() => InvokeAsync(RefreshAsync)));
        Nav.LocationChanged += OnLocationChanged;
    }

    private int _generation;

    private async Task RefreshAsync()
    {
        var generation = ++_generation;

        var projects = await Browser.ListProjectsAsync(CancellationToken.None);

        var route = ProjectRoute.Parse(Nav.ToBaseRelativePath(Nav.Uri));
        var activeTab = route?.Tab;
        WisdomAttention? wisdomAttention = null;
        CaptureAttention? captureAttention = null;
        RecallAttention? recallAttention = null;
        if (route is { ProjectId: var projectId, Tab: var tab })
        {
            switch (tab)
            {
                case "wisdom":
                    wisdomAttention = await Browser.GetWisdomAttentionAsync(projectId, CancellationToken.None);
                    break;
                case "injections":
                    recallAttention = await Browser.GetRecallAttentionAsync(projectId, CancellationToken.None);
                    break;
                default:
                    captureAttention = await Browser.GetCaptureAttentionAsync(projectId, CancellationToken.None);
                    break;
            }
        }

        if (generation != _generation)
        {
            return;
        }

        _projects = projects;
        _activeTab = activeTab;
        _activeProject = route?.ProjectId;
        _activeLens = WisdomRoute.LensOf(Nav.ToAbsoluteUri(Nav.Uri));
        _wisdomAttention = wisdomAttention;
        _captureAttention = captureAttention;
        _recallAttention = recallAttention;

        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(RefreshAsync);

    private bool IsSelectedProject(Guid id)
        => Nav.ToBaseRelativePath(Nav.Uri).StartsWith($"projects/{id}", StringComparison.OrdinalIgnoreCase);

    private static string LensHref(Guid projectId, WisdomLens lens)
        => WisdomRoute.Listing(projectId, lens);

    private bool IsLens(WisdomLens lens) => _activeLens == lens;

    private static string GroupTitle(string tab) => tab switch
    {
        "wisdom" => "Needs attention",
        "injections" => "Recall",
        _ => "Capture",
    };

    public void Dispose()
    {
        _subscription?.Dispose();
        Nav.LocationChanged -= OnLocationChanged;
        _debounce?.Dispose();
    }
}
