@using Microsoft.Extensions.Options
@using Mimir.Server.Capture
@using Mimir.Server.Configuration
@using Mimir.Server.Storage.Entities
@using Mimir.Server.Ui
@implements IDisposable
@inject EpisodeBrowser Browser
@inject IEpisodeFeed Feed
@inject NavigationManager Nav
@inject IOptions<DistillationOptions> Distillation
@inject ILogger<EpisodeSurface> Logger

<div class="episode-surface">
    <EpisodeList ProjectId="ProjectId" ProjectName="@ProjectName" IsGlobal="IsGlobal"
                 SelectedId="SelectedId" />

    <div class="pane-detail-frame">
        @if (SelectedId is null)
        {
            <main class="pane-detail">
                <div class="pane-detail-body">
                    <p class="pane-placeholder">
                        Pick a session to read its Event stream, and the durable memory it produced.
                    </p>
                </div>
            </main>
        }
        else if (_detail is { } detail)
        {
            <EpisodeDrillDown Detail="detail" ProjectId="ProjectId" Error="@FailureFor(detail.Episode.Id)"
                              OnDeleteEvent="DeleteEventAsync" OnDeleteEpisode="DeleteEpisodeAsync" />

            <aside class="pane-aside">
                <div>
                    <h6>This session</h6>
                    <div class="aside-figure">
                        <span class="aside-figure-value">@detail.Events.Count.ToString("N0")</span>
                        <span class="aside-figure-unit">
                            @(detail.Events.Count == 1 ? "Event" : "Events"),
                            @detail.PromptCount.ToString("N0")
                            @(detail.PromptCount == 1 ? "prompt" : "prompts")
                        </span>
                    </div>
                    @* is-prose: the one aside whose values are phrases rather than numerals, so the
                       slack goes to the value's column. *@
                    <dl class="aside-rows is-prose">
                        <dt>Duration</dt>
                        <dd class="is-strong">
                            @(EpisodeDisplay.Duration(detail.Episode.StartedAt, detail.Episode.SealedAt)
                                ?? "still open")
                        </dd>
                        <dt>Wisdom produced</dt>
                        <dd class="is-accent">@detail.Produced.Count.ToString("N0")</dd>
                        @if (detail.Episode.SealedAt is { } sealedAt)
                        {
                            <dt>Sealed</dt>
                            <dd>@EpisodeDisplay.Stamp(sealedAt)</dd>
                        }
                        <dt>Seal reason</dt>
                        <dd>
                            @(detail.Episode.SealedAt is null
                                ? "not sealed"
                                : EpisodeDisplay.SealPhrase(detail.Episode.SealReason))
                        </dd>
                    </dl>
                    <p class="aside-note">
                        @(detail.Episode.SealedAt is null
                            ? "Unsealed: the session is live, or it crashed. The sweep Seals one"
                              + $" whose Events stopped over {EpisodeDisplay.Hours(Sweep.CrashSealIdleAfter)} ago"
                              + $" as {Episode.CrashSweptReason} (§4)."
                            : "A Seal always carries its reason — the hook's own, or"
                              + $" {Episode.CrashSweptReason} where the sweep closed a session that"
                              + " never reported one.")
                    </p>
                </div>

                <div>
                    <h6>Distillation</h6>
                    <p class="aside-state">
                        @EpisodeDisplay.DistillationPhrase(
                            detail.Episode.SealedAt, detail.Episode.Distillation)
                    </p>
                    <p class="aside-note">
                        Sealing enqueues; a worker claims one Episode at a time. The sweep runs every
                        @EpisodeDisplay.Hours(Sweep.SweepInterval), resets a claim still standing after
                        @EpisodeDisplay.Hours(Sweep.StaleRunningAfter) — a worker that died mid-run leaves
                        <em>running</em> behind — and re-queues a failure. A <em>done</em> Episode is
                        never distilled again: a second pass would re-merge the same lessons and
                        inflate their Reinforcement.
                    </p>
                    @if (detail.Episode.DistilledAt is { } distilledAt)
                    {
                        <p class="aside-note">Last distilled @EpisodeDisplay.Stamp(distilledAt).</p>
                    }
                </div>
            </aside>
        }
        else if (_loadedId == SelectedId)
        {
            <main class="pane-detail">
                <div class="pane-detail-body">
                    <p class="pane-placeholder">
                        This Episode does not exist — most likely it was hard-deleted (§8.2), which
                        takes its Events with it.
                    </p>
                </div>
            </main>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Guid ProjectId { get; set; }

    [Parameter, EditorRequired]
    public string ProjectName { get; set; } = string.Empty;

    [Parameter]
    public bool IsGlobal { get; set; }

    [Parameter]
    public Guid? SelectedId { get; set; }

    private Mimir.Server.Ui.EpisodeDetail? _detail;

    // Which id _detail answers for, including when the answer was "nothing" — against
    // _requestedId's "was asked for".
    private Guid? _loadedId;

    private Guid? _requestedId;

    private (Guid Subject, string Text)? _failure;

    private IDisposable? _subscription;
    private Debouncer? _debounce;
    private int _generation;

    private DistillationOptions Sweep => Distillation.Value;

    protected override void OnInitialized()
    {
        _debounce = new Debouncer(
            Debouncer.DefaultDelay, Logger, "Episode drill-down refresh", Debouncer.DefaultCeilingMultiple);

        _subscription = Feed.Subscribe(change =>
        {
            if (change.EpisodeId == SelectedId)
            {
                _debounce?.Schedule(() => InvokeAsync(RefreshAsync));
            }
        });
    }

    protected override Task OnParametersSetAsync()
    {
        if (_requestedId == SelectedId)
        {
            return Task.CompletedTask;
        }

        _requestedId = SelectedId;
        return RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (SelectedId is not { } episodeId)
        {
            // Counts as a read, so a query still in flight for the Episode just left cannot pass
            // the generation check below and paint over the cleared pane.
            _generation++;
            (_detail, _loadedId) = (null, null);
            return;
        }

        var generation = ++_generation;
        var detail = await Browser.GetEpisodeAsync(episodeId, CancellationToken.None);

        if (generation != _generation)
        {
            return;
        }

        (_detail, _loadedId) = (detail, episodeId);
        StateHasChanged();
    }

    private Task DeleteEventAsync(Guid eventId) => DeleteAsync(
        _detail?.Episode.Id ?? Guid.Empty,
        () => Browser.DeleteEventAsync(eventId, CancellationToken.None),
        "The Event was not deleted — Postgres has to be reachable. "
            + "Check the Health pill; this Event is untouched.");

    private Task DeleteEpisodeAsync(Guid episodeId) => DeleteAsync(
        episodeId,
        async () =>
        {
            await Browser.DeleteEpisodeAsync(episodeId, CancellationToken.None);

            if (SelectedId == episodeId)
            {
                Nav.NavigateTo($"projects/{ProjectId}/episodes");
            }
        },
        "The Episode was not deleted — Postgres has to be reachable. "
            + "Check the Health pill; this session is untouched.");

    private async Task DeleteAsync(Guid subject, Func<Task> delete, string failure)
    {
        _failure = null;
        try
        {
            await delete();
        }
        catch (Exception ex)
        {
            // Swallowed and said inline: unhandled, an exception out of a Blazor event handler
            // takes the circuit down and the curator loses their place.
            Logger.LogWarning(ex, "Episode delete failed");
            _failure = (subject, failure);
        }
    }

    private string? FailureFor(Guid onScreen)
        => _failure is { } failed && failed.Subject == onScreen ? failed.Text : null;

    public void Dispose()
    {
        _subscription?.Dispose();
        _debounce?.Dispose();
    }
}
