@using Microsoft.Extensions.Options
@using Mimir.Server.Capture
@using Mimir.Server.Configuration
@using Mimir.Server.Storage.Entities
@using Mimir.Server.Ui
@implements IDisposable
@inject EpisodeBrowser Browser
@inject IEpisodeFeed Feed
@inject NavigationManager Nav
@inject IOptions<DistillationOptions> Distillation
@inject ILogger<EpisodeSurface> Logger

@* Spec §8.2 on the four-pane shape (#95): the list, the session it is opened on, and that
   session's own numbers down the side. One component across both routes — the listing route
   renders the placeholder, the drill-down route renders with that Episode selected — so clicking a
   row keeps the list in place instead of tearing the surface down and re-querying it. *@
<div class="episode-surface">
    <EpisodeList ProjectId="ProjectId" ProjectName="@ProjectName" IsGlobal="IsGlobal"
                 SelectedId="SelectedId" />

    <div class="pane-detail-frame">
        @if (SelectedId is null)
        {
            <main class="pane-detail">
                <div class="pane-detail-body">
                    <p class="pane-placeholder">
                        Pick a session to read its Event stream, and the durable memory it produced.
                    </p>
                </div>
            </main>
        }
        else if (_detail is { } detail)
        {
            <EpisodeDrillDown Detail="detail" ProjectId="ProjectId"
                              OnDeleteEvent="DeleteEventAsync" OnDeleteEpisode="DeleteEpisodeAsync" />
        }
        else if (_loadedId == SelectedId)
        {
            <main class="pane-detail">
                <div class="pane-detail-body">
                    <p class="pane-placeholder">
                        This Episode does not exist — most likely it was hard-deleted (§8.2), which
                        takes its Events with it.
                    </p>
                </div>
            </main>
        }

        @* Only alongside a session: the aside is one Episode's numbers, so with nothing selected
           there is nothing for it to carry and an empty ruled column would read as a fault. *@
        @if (_detail is { } aside)
        {
            <aside class="pane-aside">
                <div>
                    <h6>This session</h6>
                    <div class="aside-figure">
                        <span class="aside-figure-value">@aside.Events.Count.ToString("N0")</span>
                        <span class="aside-figure-unit">
                            @(aside.Events.Count == 1 ? "Event" : "Events"),
                            @aside.PromptCount.ToString("N0")
                            @(aside.PromptCount == 1 ? "prompt" : "prompts")
                        </span>
                    </div>
                    <dl class="aside-rows">
                        <dt>Duration</dt>
                        <dd class="is-strong">
                            @(EpisodeDisplay.Duration(aside.Episode.StartedAt, aside.Episode.SealedAt)
                                ?? "still open")
                        </dd>
                        <dt>Wisdom produced</dt>
                        <dd class="is-accent">@aside.Produced.Count.ToString("N0")</dd>
                        <dt>Seal reason</dt>
                        <dd>
                            @(aside.Episode.SealedAt is null
                                ? "not sealed"
                                : EpisodeDisplay.SealPhrase(aside.Episode.SealReason))
                        </dd>
                    </dl>
                    <p class="aside-note">
                        @(aside.Episode.SealedAt is null
                            ? "Unsealed: the session is live, or it crashed. The sweep Seals one"
                              + $" whose Events stopped over {EpisodeDisplay.Hours(Sweep.CrashSealIdleAfter)} ago"
                              + $" as {Episode.CrashSweptReason} (§4)."
                            : "A Seal always carries its reason — the hook's own, or"
                              + $" {Episode.CrashSweptReason} where the sweep closed a session that"
                              + " never reported one.")
                    </p>
                </div>

                <div>
                    <h6>Distillation</h6>
                    <p class="aside-state">
                        @EpisodeDisplay.DistillationPhrase(
                            aside.Episode.SealedAt, aside.Episode.Distillation)
                    </p>
                    @* The four elements the design drew here and #86 dropped are absent rather than
                       stubbed: the claiming model, the candidate count and the chunk count are
                       nothing §6 records, and "Recalled since" would need a link from an Injection
                       back to the Episode a carried Wisdom came from, which does not exist. *@
                    <p class="aside-note">
                        Sealing enqueues; a worker claims one Episode at a time. The sweep runs every
                        @EpisodeDisplay.Hours(Sweep.SweepInterval), resets a claim still standing after
                        @EpisodeDisplay.Hours(Sweep.StaleRunningAfter) — a worker that died mid-run leaves
                        <em>running</em> behind — and re-queues a failure. A <em>done</em> Episode is
                        never distilled again: a second pass would re-merge the same lessons and
                        inflate their Reinforcement.
                    </p>
                    @if (aside.Episode.DistilledAt is { } distilledAt)
                    {
                        <p class="aside-note">Last distilled @EpisodeDisplay.Stamp(distilledAt).</p>
                    }
                </div>
            </aside>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Guid ProjectId { get; set; }

    [Parameter, EditorRequired]
    public string ProjectName { get; set; } = string.Empty;

    [Parameter]
    public bool IsGlobal { get; set; }

    /// <summary>Null on the listing route; the drill-down route supplies the Episode.</summary>
    [Parameter]
    public Guid? SelectedId { get; set; }

    private Mimir.Server.Ui.EpisodeDetail? _detail;

    /// <summary>
    /// Which id <see cref="_detail"/> answers for, including when the answer was "nothing". Without
    /// it a deleted Episode and one whose query is still in flight both render as no detail, and
    /// the "hard-deleted" note would flash on every drill-down.
    /// </summary>
    private Guid? _loadedId;

    private IDisposable? _subscription;
    private Debouncer? _debounce;
    private int _generation;

    /// <summary>The §11 knobs the Distillation aside states the sweep's rules from.</summary>
    private DistillationOptions Sweep => Distillation.Value;

    protected override void OnInitialized()
    {
        // A live session's Episode grows while this pane is open (§8.2). Coalesced with the
        // feed-driven ceiling for the reason the list states: a burst of captured Events must
        // neither be answered one query at a time nor postpone the pane indefinitely.
        _debounce = new Debouncer(
            Debouncer.DefaultDelay, Logger, "Episode drill-down refresh", Debouncer.DefaultCeilingMultiple);

        _subscription = Feed.Subscribe(change =>
        {
            if (change.EpisodeId == SelectedId)
            {
                _debounce?.Schedule(() => InvokeAsync(RefreshAsync));
            }
        });
    }

    protected override Task OnParametersSetAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        if (SelectedId is not { } episodeId)
        {
            (_detail, _loadedId) = (null, null);
            return;
        }

        var generation = ++_generation;
        var detail = await Browser.GetEpisodeAsync(episodeId, CancellationToken.None);

        // A newer read — another row clicked, a later Event — may have landed while this one was
        // awaiting its queries; drop this one rather than paint the Episode the curator just left.
        if (generation != _generation)
        {
            return;
        }

        (_detail, _loadedId) = (detail, episodeId);
        StateHasChanged();
    }

    // No explicit refresh after the Event delete: the browser announces it on the feed, and this
    // pane's own subscription is a subscriber like any other.
    private Task DeleteEventAsync(Guid eventId)
        => Browser.DeleteEventAsync(eventId, CancellationToken.None);

    private async Task DeleteEpisodeAsync()
    {
        if (SelectedId is { } episodeId)
        {
            await Browser.DeleteEpisodeAsync(episodeId, CancellationToken.None);
            Nav.NavigateTo($"projects/{ProjectId}/episodes");
        }
    }

    public void Dispose()
    {
        _subscription?.Dispose();
        _debounce?.Dispose();
    }
}
