@page "/projects/{ProjectId:guid}/episodes"
@page "/projects/{ProjectId:guid}/episodes/{EpisodeId:guid}"
@using Mimir.Server.Components.Episodes
@using Mimir.Server.Ui
@inject ChassisBrowser Browser

<PageTitle>Episodes · Mimir</PageTitle>

@if (_project is null)
{
    <UnknownProject />
}
else
{
    <h1 class="sr-only">Episodes</h1>

    <EpisodeSurface ProjectId="ProjectId"
                    ProjectName="@_project.DisplayName"
                    IsGlobal="_project.IsGlobal"
                    SelectedId="EpisodeId" />
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [Parameter]
    public Guid? EpisodeId { get; set; }

    private ProjectListItem? _project;
    private Guid _loadedProject;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProject == ProjectId)
        {
            return;
        }

        _loadedProject = ProjectId;
        _project = await Browser.GetProjectAsync(ProjectId, CancellationToken.None);
    }
}
