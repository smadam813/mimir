@page "/projects/{ProjectId:guid}"
@page "/projects/{ProjectId:guid}/{Tab}"
@using Mimir.Server.Components.Episodes
@using Mimir.Server.Components.Injections
@using Mimir.Server.Components.Wisdom
@using Mimir.Server.Ui
@inject ChassisBrowser Browser

@* The full tab strip — with this Project's counts — is the layout's SurfaceTabStrip, above
   @Body; this page renders only the selected tab's body (#89). *@
<PageTitle>@(_project?.DisplayName ?? "Project") · Mimir</PageTitle>

@if (_project is null)
{
    <div class="legacy-surface">
        <h1>Unknown Project</h1>
        <p class="lede">Nothing lives at this id — the Project may have been deleted.</p>
    </div>
}
else
{
    <h1 class="sr-only">@_project.DisplayName</h1>

    @* A ported surface fills the body with its own panes; the two still on the old stylesheet keep
       the padded page they were written as, until #97 retires it with them. *@
    @switch (ActiveTab)
    {
        case "wisdom":
            <div class="legacy-surface">
                <WisdomBrowserTab ProjectId="ProjectId" />
            </div>
            break;

        case "injections":
            <div class="legacy-surface">
                <InjectionLogTab ProjectId="ProjectId" />
            </div>
            break;

        default:
            <EpisodeList ProjectId="ProjectId"
                         ProjectName="@_project.DisplayName"
                         IsGlobal="_project.IsGlobal" />
            break;
    }
}

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [Parameter]
    public string? Tab { get; set; }

    private ProjectListItem? _project;

    private string ActiveTab => Tab?.ToLowerInvariant() switch
    {
        "wisdom" => "wisdom",
        "injections" => "injections",
        _ => "episodes",
    };

    protected override async Task OnParametersSetAsync()
        => _project = await Browser.GetProjectAsync(ProjectId, CancellationToken.None);
}
