@page "/projects/{ProjectId:guid}/wisdom"
@page "/projects/{ProjectId:guid}/wisdom/{WisdomId:guid}"
@using Mimir.Server.Components.Wisdom
@using Mimir.Server.Ui

<PageTitle>Wisdom · Mimir</PageTitle>

<h1 class="sr-only">Wisdom</h1>

<WisdomSurface ProjectId="ProjectId" SelectedId="WisdomId" Lens="WisdomRoute.ParseLens(Show)" />

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [Parameter]
    public Guid? WisdomId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = WisdomRoute.LensName)]
    public string? Show { get; set; }
}
