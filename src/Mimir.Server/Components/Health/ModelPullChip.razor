@using Mimir.Contracts.Health
@using Mimir.Server.Health
@implements IDisposable
@inject IHealthState HealthState

@* Spec §8 / #90: the model pull, stated in the header while it is the one genuinely slow step a
   new install is waiting on. A sibling of HealthPill rather than markup inside AppHeader: both
   observe the same probe, and mounting this only on first run is what keeps the header off a
   health subscription it would never read for the rest of the install's life.

   Renders nothing when no model is pulling — a §11 model already Ready, still Pending or Failed
   outright is not a pull, and the Health popover beside this is where those are stated. *@
@if (ModelPull.From(_snapshot.Ollama) is { } pull)
{
    <div class="model-pull">
        <span class="model-pull-dot" aria-hidden="true"></span>
        <span>Pulling <code>@pull.Name</code></span>
        @if (pull.PercentComplete is { } percent)
        {
            <span class="model-pull-track" aria-hidden="true">
                <i style="width: @(percent)%"></i>
            </span>
            <span class="model-pull-percent">@percent%</span>
        }
        <span class="model-pull-note">· once, in the background — Capture does not wait for it</span>
    </div>
}

@code {
    private HealthSnapshot _snapshot = HealthSnapshot.Pending;
    private IDisposable? _subscription;

    protected override void OnInitialized()
    {
        _snapshot = HealthState.Current;

        // Probes push from background threads; hop onto the circuit's dispatcher to re-render.
        _subscription = HealthState.Subscribe(snapshot => InvokeAsync(() =>
        {
            _snapshot = snapshot;
            StateHasChanged();
        }));
    }

    public void Dispose() => _subscription?.Dispose();
}
