@using Mimir.Server.Storage.Entities
@using Mimir.Server.Ui
@implements IDisposable
@inject WisdomBrowser Browser
@inject ChassisBrowser Chassis
@inject SurfaceSearch Search
@inject NavigationManager Nav
@inject ILogger<WisdomSurface> Logger

@* Spec §8.1, one screen: the list and the detail are panes of the same surface, so a curator can
   work down a list without losing their place (#91). The list is the selected Project's Ambient
   Candidate Universe — its Wisdom plus Global (ADR-0009) — which is what a session in that
   repository actually recalls, and what makes the per-row Scope label mean something. Both routes
   render this: the listing route with nothing selected, the detail route with that Wisdom
   selected, so every existing deep link still resolves. *@
<div class="wisdom-surface">
    <section class="list-pane" aria-label="Wisdom">
        <header class="list-head">
            <div class="list-title">
                <h4>@Words.Heading</h4>
                @if (_listing is { } counts)
                {
                    @* Both figures, not one: the sidebar's counts stay Project-owned, so they no
                       longer match this list's length. Stating the arithmetic beats leaving it as
                       an inference (ADR-0009). *@
                    <span class="list-counts" title="This Project's own Wisdom plus Global — the set a session here recalls (§7)">
                        @if (IsGlobal)
                        {
                            <span>@counts.Global · Global</span>
                        }
                        else
                        {
                            <span>@counts.ProjectOwned · @ProjectName</span>
                            <span class="counts-join">+</span>
                            <span>@counts.Global · Global</span>
                        }
                    </span>
                }
            </div>

            @if (_listing is { } chips)
            {
                <div class="chips" role="group" aria-label="Filter by Kind">
                    <button type="button" class="btn btn-secondary chip @(_kind is null ? "is-active" : null)"
                            aria-pressed="@Pressed(_kind is null)" @onclick="() => SetKindAsync(null)">
                        All
                    </button>
                    @foreach (var chip in chips.Kinds)
                    {
                        <button type="button" class="btn btn-secondary chip @(_kind == chip.Kind ? "is-active" : null)"
                                aria-pressed="@Pressed(_kind == chip.Kind)"
                                @onclick="() => SetKindAsync(chip.Kind)">
                            @chip.Kind<span class="chip-count">@chip.Count</span>
                        </button>
                    }
                </div>
            }
        </header>

        <div class="list-rows">
            @if (_listing is { Entries.Count: 0 })
            {
                <p class="pane-note">@Words.Empty</p>
            }
            else if (_listing is { } listed)
            {
                @foreach (var entry in listed.Entries)
                {
                    <a @key="entry.Id" href="@DetailHref(entry.Id)"
                       class="wisdom-row @(entry.Id == SelectedId ? "is-selected" : null) @(entry.RetiredAt is not null ? "is-retired" : null)">
                        <span class="row-head">
                            <KindGlyph Kind="entry.Kind" />
                            <span class="row-kind">@entry.Kind</span>
                            <span class="row-scope" title="Scope (§3)">@entry.ScopeName</span>
                            @if (entry.ContestedAt is not null)
                            {
                                <span class="row-state state-accent">contested</span>
                            }
                            @if (entry.OrphanedProvenance)
                            {
                                <span class="row-state state-danger">orphaned</span>
                            }
                            @if (entry.RetiredAt is not null)
                            {
                                <span class="row-state">retired</span>
                            }
                            <span class="row-reinforcement" title="Reinforcement (§6)">×@entry.Reinforcement</span>
                        </span>
                        <span class="row-text">@entry.Text</span>
                    </a>
                }
            }
        </div>
    </section>

    <div class="pane-detail-frame">
        <div class="detail-column">
            <main class="detail-pane">
                @if (SelectedId is null)
                {
                    <p class="pane-note detail-empty">
                        Pick a Wisdom to read it, edit its words, or retire it. The list beside this is
                        everything a session in this repository recalls (§7).
                    </p>
                }
                else if (_detail is not { } detail)
                {
                    <p class="pane-note detail-empty">
                        Nothing lives at this id — most likely it was deleted with its chain (§10).
                        <a href="@ListHref">Back to the list</a>
                    </p>
                }
                else
                {
                    var entry = detail.Entry;

                    <div class="detail-head">
                        <span class="detail-kind"><KindGlyph Kind="entry.Kind" />@entry.Kind</span>
                        <span class="detail-sep">/</span>
                        <span class="detail-fact">scope <strong>@entry.ScopeName</strong></span>
                        @if (detail.FirstVersionAt is { } first)
                        {
                            <span class="detail-sep">/</span>
                            <span class="detail-fact">first written @EpisodeDisplay.Stamp(first)</span>
                        }
                    </div>

                    @if (entry.ContestedAt is { } contestedAt)
                    {
                        <p class="detail-state state-accent">
                            Contested since @EpisodeDisplay.Stamp(contestedAt) — it survived an adjudication
                            against a contradicting claim (§6.4).
                        </p>
                    }
                    @if (entry.RetiredAt is { } retiredAt)
                    {
                        <p class="detail-state">
                            Retired since @EpisodeDisplay.Stamp(retiredAt) — out of all recall and default
                            search, reversibly (§10). Its words stay editable, and an edit never unretires it.
                        </p>
                    }
                    @if (entry.SupersededBy is { } successor)
                    {
                        <p class="detail-state">
                            Superseded by <a href="@DetailHref(successor)">the ruling's survivor</a>.
                        </p>
                    }

                    @if (_mode is DetailMode.Editing)
                    {
                        <div class="text-head">
                            <h6 class="text-title is-editing">
                                The text · editing v@(detail.CurrentVersion) → v@(detail.CurrentVersion + 1)
                            </h6>
                            <span class="text-count">@WisdomDisplay.CharacterCount(_draft.Length)</span>
                        </div>
                        <textarea class="input detail-editor" @bind="_draft" @bind:event="oninput"
                                  aria-label="Edited Wisdom text"></textarea>
                        <div class="detail-actions">
                            <button class="btn btn-primary"
                                    disabled="@(_saving || WisdomDisplay.UnsavableReason(_draft, entry.Text) is not null)"
                                    @onclick="SaveAsync">
                                Save edit
                            </button>
                            <button class="btn btn-secondary" disabled="@_saving"
                                    @onclick="() => _mode = DetailMode.Viewing">Cancel</button>
                            @if (WisdomDisplay.UnsavableReason(_draft, entry.Text) is { } why)
                            {
                                <span class="detail-hint">@why</span>
                            }
                        </div>

                        @* §8.1's own acceptance criterion: what saving does, on the screen rather than
                           in the spec. The sentence itself lives in WisdomDisplay, where a test holds
                           it to the gate it describes — markup no test renders holds it to nothing. *@
                        <p class="edit-explains">
                            @WisdomDisplay.EditExplanation(detail.CurrentVersion + 1, entry.Reinforcement)
                        </p>
                    }
                    else
                    {
                        <p class="detail-text @(entry.RetiredAt is not null ? "is-retired" : null)">@entry.Text</p>
                        <div class="detail-actions">
                            <button class="btn btn-secondary" @onclick="() => BeginEdit(entry)">Edit</button>
                            @if (entry.RetiredAt is null)
                            {
                                <button class="btn btn-secondary"
                                        title="Reversibly exclude from recall and default search (§10)"
                                        @onclick="() => RetireAsync(entry.Id)">
                                    Retire
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-secondary" @onclick="() => UnretireAsync(entry.Id)">Unretire</button>
                            }
                            <span class="detail-hint">@WisdomDisplay.RetireHint(entry.RetiredAt is not null)</span>
                        </div>
                    }
                    @if (FailureFor(entry.Id) is { } failure)
                    {
                        <p class="pane-error" role="alert">@failure</p>
                    }

                    @* §8.1's version chain (#93). Two views of one list: what each version changed
                       against the one below it, or every version whole. The choice outlives the
                       selection deliberately — see _chainView. *@
                    <div class="chain-head">
                        <h5 class="detail-section">
                            Version chain
                            <span class="version-total">@WisdomDisplay.VersionCount(detail.Versions.Count)</span>
                        </h5>
                        <span class="chain-toggle" role="group" aria-label="How the version chain reads">
                            <button type="button" class="chain-view @(_chainView is VersionChainView.Changed ? "is-active" : null)"
                                    aria-pressed="@Pressed(_chainView is VersionChainView.Changed)"
                                    @onclick="() => _chainView = VersionChainView.Changed">
                                What changed
                            </button>
                            <button type="button" class="chain-view @(_chainView is VersionChainView.Full ? "is-active" : null)"
                                    aria-pressed="@Pressed(_chainView is VersionChainView.Full)"
                                    @onclick="() => _chainView = VersionChainView.Full">
                                Full text
                            </button>
                        </span>
                    </div>
                    <ol class="version-list">
                        @* The draft rides in as the version it would become, so a curator reads their
                           own rewording against what stands before committing it. Passed raw, beside
                           the same text the Save button reads: whether it is a version at all is the
                           gate's no-op set to decide, which is what keeps this row and that button
                           from disagreeing. The chain under it was diffed when the Wisdom was read —
                           only this row is a function of the keystroke. *@
                        @foreach (var version in WisdomDisplay.WithPendingEdit(
                            _chain, entry.Text, _mode is DetailMode.Editing ? _draft : null))
                        {
                            @* Keyed on the version, because this is the one list on the surface that
                               grows at its head: the first keystroke that parts the draft from the
                               stored text inserts the pending row, and positionally Blazor would
                               re-patch every row below it — each one's badge, stamp and whole run
                               tree — rather than the one node that arrived. *@
                            <li @key="version.Version"
                                class="version-row @(version.Pending ? "is-pending" : null)">
                                <span class="version-rail" aria-hidden="true">
                                    <i class="version-dot"></i>
                                    <i class="version-line"></i>
                                </span>
                                <div class="version-body">
                                    <div class="version-meta">
                                        <span class="version-seq">v@(version.Version)</span>
                                        <span class="version-cause">
                                            @WisdomDisplay.CauseWord(version.Cause)@(version.Pending ? " · unsaved" : null)
                                        </span>
                                        @if (version.At is { } at)
                                        {
                                            <span class="version-at">@EpisodeDisplay.Stamp(at)</span>
                                        }
                                        @if (_chainView is VersionChainView.Full)
                                        {
                                            <span class="version-chars">
                                                @WisdomDisplay.CharacterCount(version.Text.Length)
                                            </span>
                                        }
                                    </div>
                                    @if (_chainView is VersionChainView.Changed)
                                    {
                                        @* The roles are each element's own implicit one, spelled out
                                           because browsers largely do not expose it otherwise: bare
                                           del and ins, a screen reader reads straight through, and
                                           the row becomes the old wording and the new one spoken as
                                           one sentence no version ever said. *@
                                        <p class="version-text">@foreach (var run in version.Changed)
                                            {
                                                @if (run.Change is TextChange.Removed)
                                                {
                                                    <del role="deletion">@run.Text</del>
                                                }
                                                else if (run.Change is TextChange.Added)
                                                {
                                                    <ins role="insertion">@run.Text</ins>
                                                }
                                                else
                                                {
                                                    @run.Text
                                                }
                                            }</p>
                                    }
                                    else
                                    {
                                        <p class="version-text is-full">@version.Text</p>
                                    }
                                    @if (version.Pending)
                                    {
                                        <p class="version-note">
                                            Not yet through the Merge Gate — nothing recalls this
                                            wording until you save.
                                        </p>
                                    }
                                </div>
                            </li>
                        }
                    </ol>

                    @* §8.1: Delete is the permanent act — confirmed, and kept visibly apart from Retire,
                       which is not (§10). Absent entirely while the editor is open, so "Delete forever"
                       can never be the click that throws away a draft the curator is still typing.

                       Keyed and captioned off the detail on screen rather than off SelectedId, for
                       the reason ConfirmDelete.OnConfirm gives. *@
                    @if (_mode is not DetailMode.Editing)
                    {
                        <div class="pane-danger">
                            <ConfirmDelete Label="Delete Wisdom…" SubjectKey="detail.Entry.Id"
                                           Prompt="@($"Hard-delete this Wisdom and its {detail.Versions.Count}-version chain forever? Nothing reverses this.")"
                                           OnConfirm="DeleteAsync" />
                        </div>
                    }
                }
            </main>

            @* What the chain's badges mean, on the screen rather than looked up (§8.1). Pinned under
               the pane it explains, and only beside a Wisdom — over the unselected placeholder it
               would be a glossary for badges that are not there. Its entries are the enum's, so a
               cause §3 gains cannot go missing from it.

               The condition is the chain's own, both halves: a list-only refresh deliberately leaves
               _detail alone, so one that wins the generation check over a navigation to the listing
               route leaves a detail standing under a null selection. _detail alone would draw the
               legend over the placeholder there. *@
            @if (SelectedId is not null && _detail is not null)
            {
                <footer class="cause-legend">
                    <p>
                        @foreach (var gloss in WisdomDisplay.CauseLegend)
                        {
                            @* One flowing paragraph, so each entry ends in a real space rather than a
                               margin: two elements with only a gap between them give the renderer
                               nowhere to break the line. It rides in the expression because Razor
                               trims literal whitespace between elements. *@
                            <b>@gloss.Word</b>@($" — {gloss.Meaning} ")
                        }
                    </p>
                </footer>
            }
        </div>

        @* The numbers a curator judges by: what has confirmed this Wisdom, what Recall has done
           with it, and what it came from. Only ever beside a Wisdom — an aside of blanks over the
           unselected placeholder would be three headings claiming nothing. *@
        @if (_detail is { } aside)
        {
            <aside class="pane-aside">
                <div>
                    <h6>Reinforcement</h6>
                    <div class="aside-figure">
                        <span class="aside-figure-value">@aside.Entry.Reinforcement.ToString("N0")</span>
                        <span class="aside-figure-unit">
                            @WisdomDisplay.ReinforcementUnit(aside.Entry.Reinforcement)
                        </span>
                    </div>
                    <div class="reinforcement-bar" aria-hidden="true">
                        @for (var segment = 0; segment < WisdomDisplay.ReinforcementBarSegments; segment++)
                        {
                            <i class="@(segment < WisdomDisplay.ReinforcementFilled(aside.Entry.Reinforcement)
                                        ? "is-lit" : null)"></i>
                        }
                    </div>
                    <p class="aside-note">
                        last confirmed @EpisodeDisplay.Stamp(aside.Entry.LastConfirmedAt) — an
                        Admission moves this, an edit does not (§6).
                    </p>
                </div>

                <div>
                    <h6>Recall</h6>
                    <dl class="aside-rows">
                        @foreach (var lane in aside.Recall.Lanes)
                        {
                            <dt @key="lane.Lane">@InjectionDisplay.Name(lane.Lane) lane</dt>
                            <dd class="is-strong">@lane.Entries.ToString("N0")</dd>
                        }
                        <dt>Marked useful</dt><dd class="is-accent">@aside.Recall.MarkedUseful.ToString("N0")</dd>
                        <dt>Marked noise</dt><dd>@aside.Recall.MarkedNoise.ToString("N0")</dd>
                    </dl>
                    <p class="aside-note">@WisdomDisplay.RecallNote(aside.Recall)</p>
                </div>

                <div>
                    <div class="aside-head">
                        <h6>Where this came from</h6>
                        <span class="aside-head-count">@aside.Provenance.Count</span>
                    </div>
                    @if (aside.Entry.OrphanedProvenance)
                    {
                        <p class="aside-orphaned">
                            Orphaned: every Episode, Event and Harvested Item this Wisdom derived
                            from was deleted, and the cascade took the links with them (§3). The
                            words and the version chain survive; only the trail back is gone, and
                            nothing reverses it.
                        </p>
                    }
                    else
                    {
                        <div class="aside-links">
                            @foreach (var link in aside.Provenance)
                            {
                                @if (link.EpisodeId is not null)
                                {
                                    <a class="aside-link" @key="link.Id" href="@EpisodeHref(link)">
                                        <span class="aside-link-title">@WisdomDisplay.ProvenanceTitle(link)</span>
                                        <span class="aside-link-detail">@WisdomDisplay.ProvenanceDetail(link)</span>
                                    </a>
                                }
                                else
                                {
                                    @* Nothing to open: a harvested file and a deliberate save are
                                       records with no §8.2 surface of their own. *@
                                    <span class="aside-link" @key="link.Id">
                                        <span class="aside-link-title">@WisdomDisplay.ProvenanceTitle(link)</span>
                                        <span class="aside-link-detail">@WisdomDisplay.ProvenanceDetail(link)</span>
                                    </span>
                                }
                            }
                        </div>
                        @if (WisdomDisplay.ProvenanceNote(aside.Provenance) is { } promise)
                        {
                            <p class="aside-note">@promise</p>
                        }
                    }
                </div>
            </aside>
        }
    </div>
</div>

@code {
    /// <summary>The sidebar's selected Project — whose ambient universe this list is.</summary>
    [Parameter, EditorRequired]
    public Guid ProjectId { get; set; }

    /// <summary>The Wisdom the detail route named, or null on the listing route.</summary>
    [Parameter]
    public Guid? SelectedId { get; set; }

    /// <summary>Which slice of the universe — the sidebar's "Needs attention" links set this.</summary>
    [Parameter]
    public WisdomLens Lens { get; set; }

    /// <summary>
    /// Whether the detail pane is reading or editing. The confirmation that used to be a third
    /// state here is <see cref="Shared.ConfirmDelete"/>'s own since #106; what stays this surface's
    /// is the gate above it — Delete is absent entirely while the editor is open, so "Delete
    /// forever" can never be the click that throws away a draft the curator is still typing.
    /// </summary>
    private enum DetailMode { Viewing, Editing }

    private WisdomListing? _listing;
    private WisdomDetail? _detail;

    /// <summary>
    /// The selected Wisdom's saved version chain, diffed once when it is read rather than on every
    /// render: the rows below the editor cannot change while a curator types, and re-diffing the
    /// whole chain per keystroke is work the screen would only throw away. Kept in step with
    /// <see cref="_detail"/> — the two are assigned together, and neither is touched by a refresh
    /// that did not re-read the detail.
    /// </summary>
    private IReadOnlyList<VersionEntry> _chain = [];
    private Guid? _boundSelection;
    private Guid _boundProject;
    private WisdomKind? _kind;
    private ProjectListItem? _project;

    private DetailMode _mode;
    private bool _saving;
    private string _draft = "";
    /// <summary>
    /// A curation action that did not land, and the Wisdom it did not land on. The pair rather than
    /// the text alone: an action confirmed on the Wisdom still on screen can fail after the curator
    /// has clicked another row, and bare, its "this Wisdom is untouched" would render under that
    /// row's detail as a claim about it.
    /// </summary>
    private (Guid Subject, string Text)? _failure;

    /// <summary>
    /// How the version chain reads, and the one piece of detail state a selection deliberately
    /// does not reset: a curator working down a list to see what a run of edits did would
    /// otherwise re-pick it on every row. Not a URL parameter either — it is how this screen is
    /// being read right now, not what it is showing, so it has no business in a link (§8.1).
    /// </summary>
    private VersionChainView _chainView = VersionChainView.Changed;

    private IDisposable? _claim;
    private Debouncer? _debounce;
    private int _generation;

    private string ProjectName => _project?.DisplayName ?? "this Project";

    private bool IsGlobal => _project?.IsGlobal ?? false;

    private string ListHref => WisdomRoute.Listing(ProjectId, Lens);

    private string DetailHref(Guid wisdomId) => WisdomRoute.Detail(ProjectId, wisdomId, Lens);

    /// <summary>
    /// The §8.1 drill to the underlying Event: its Episode page, anchored on the Event. The
    /// fragment is <see cref="EpisodeDisplay.EventAnchorHref"/>'s, which is also what the stream
    /// writes its ids from and what opens the stream's bound on arrival — spelling it here a second
    /// time is how the link silently stops landing.
    /// </summary>
    private static string EpisodeHref(ProvenanceEntry link)
        => $"projects/{link.EpisodeProjectId}/episodes/{link.EpisodeId}"
            + (link.EventId is { } eventId ? EpisodeDisplay.EventAnchorHref(eventId) : "");

    /// <summary>What the lens is called and what its emptiness means — one switch, so the two
    /// can never describe different lenses.</summary>
    private (string Heading, string Empty) Words => Lens switch
    {
        WisdomLens.Contested => ("Contested",
            "Nothing is contested here — no adjudication has ruled against a standing claim in "
            + "the last fortnight (§6.4)."),
        WisdomLens.Orphaned => ("Orphaned",
            "Nothing is orphaned here: every Wisdom in this universe still has the trail back to "
            + "what it came from (§3)."),
        WisdomLens.Retired => ("Retired", "Nothing has been retired here yet (§10)."),
        _ => ("Wisdom",
            "No Wisdom matches. The Merge Gate fills this surface as Episodes distill and Harvest "
            + "runs (§6) — or the search and chips above are simply this narrow."),
    };

    protected override void OnInitialized()
    {
        // Typing narrows the list live, so the query waits out a burst of keystrokes rather than
        // answering each one — the same debounce the chassis's own live readouts use (#89), minus
        // the ceiling they take: Debouncer's ceilingMultiple says why a search lane gets none.
        _debounce = new Debouncer(Debouncer.DefaultDelay, Logger, "Wisdom listing refresh");

        // One search box, claimed by whichever surface is on screen (§8). Claiming before
        // subscribing keeps the claim's own reset from costing a query the first load already does.
        // Parameters are set before this runs, so anchoring here is also the first anchor: it is
        // what keeps OnParametersSetAsync's re-anchor from re-claiming over a claim one line old.
        AnchorOnProject();
        Search.Changed += OnSearchChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Selecting another row must not carry the outgoing one's half-typed draft or its inline
        // failure onto it. An armed Delete is the same rule, and it is ConfirmDelete's own to
        // enforce off SubjectKey (#106) — every host of it gets that, not just the one that
        // remembered to write the reset.
        if (_boundSelection != SelectedId)
        {
            _boundSelection = SelectedId;
            _mode = DetailMode.Viewing;
            _failure = null;
        }

        // Landing in another Project re-anchors the list on its universe, the way the tab this
        // replaced re-anchored its project filter — so nothing picked against the outgoing one
        // keeps narrowing the incoming one, and the header re-reads its name.
        if (_boundProject != ProjectId)
        {
            AnchorOnProject();
        }

        await RefreshAsync();
    }

    /// <summary>
    /// Binds this surface to <see cref="ProjectId"/>. It holds the header's box for the Project on
    /// screen, not for its own lifetime: Blazor keeps the one instance across a Project change —
    /// same route, no <c>@key</c> — so the outgoing Project's narrowings are this method's to shed,
    /// the typed term as much as the Kind chip. Re-claiming is what sheds it, since
    /// <see cref="SurfaceSearch.Claim"/> resets the term on the claiming edge and nothing else does
    /// while one instance lives (#108). Released first, for the reason
    /// <see cref="SurfaceSearch.Claim"/> states.
    /// </summary>
    private void AnchorOnProject()
    {
        _boundProject = ProjectId;
        _kind = null;
        _project = null;
        _claim?.Dispose();
        _claim = Search.Claim(this, "Search this Project's Wisdom…");
    }

    /// <summary>
    /// ARIA states are strings: a <c>bool</c> here would render as a boolean <em>attribute</em>,
    /// present-or-absent, which is not what <c>aria-pressed</c> means.
    /// </summary>
    private static string Pressed(bool active) => active ? "true" : "false";

    private void OnSearchChanged()
        => _debounce?.Schedule(() => InvokeAsync(() => RefreshAsync(reloadDetail: false)));

    /// <summary>The whole surface: the list, and the detail beside it.</summary>
    private Task RefreshAsync() => RefreshAsync(reloadDetail: true);

    /// <summary>
    /// Re-reads the surface. <paramref name="reloadDetail"/> is false for the two triggers that
    /// cannot have changed it: <see cref="WisdomBrowser.GetAsync"/> takes neither the search term
    /// nor the Kind, so a keystroke and a chip narrow the list beside the detail and nothing else.
    /// That matters more than the duplicate read it saves — the aside's recall figures are an
    /// aggregate over every logged injection, by far the most expensive read on this surface, and
    /// a debounced burst would otherwise re-run it per burst with a row selected.
    /// </summary>
    private async Task RefreshAsync(bool reloadDetail)
    {
        var generation = ++_generation;

        // The Project row only answers the header's name and Global-ness, neither of which a
        // keystroke or a chip click can change — so it is read once per universe, not once per
        // refresh. OnParametersSetAsync drops it when the Project does change.
        var project = _project ?? await Chassis.GetProjectAsync(ProjectId, CancellationToken.None);
        var listing = await Browser.ListAsync(
            new WisdomQuery(ProjectId, Search.Term, _kind, Lens), CancellationToken.None);
        var detail = reloadDetail && SelectedId is { } selected
            ? await Browser.GetAsync(selected, CancellationToken.None)
            : null;

        // A newer refresh — a later keystroke, a chip, a row click — may have landed while this
        // one was awaiting its queries; drop this one rather than overwrite fresher state with
        // stale. The same guard the sidebar carries, and this surface has more triggers than it.
        if (generation != _generation)
        {
            return;
        }

        _project = project;
        _listing = listing;

        // Left alone, not assigned null, when this refresh did not read it: a list-only refresh
        // that raced the first load would otherwise win the generation check and blank a detail
        // that was still on its way.
        if (reloadDetail)
        {
            _detail = detail;
            _chain = detail is null ? [] : WisdomDisplay.Chain(detail.Versions);
        }

        StateHasChanged();
    }

    private async Task SetKindAsync(WisdomKind? kind)
    {
        _kind = kind;
        await RefreshAsync(reloadDetail: false);
    }

    private void BeginEdit(WisdomListEntry entry)
    {
        _draft = entry.Text;
        _failure = null;
        _mode = DetailMode.Editing;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _failure = null;

        // The one action left that may read SelectedId: the editor is dropped by the selection
        // reset above before the window's first frame, so it can only be open while the selection
        // and the record on screen still agree.
        var wisdomId = SelectedId!.Value;
        try
        {
            // The edit re-embeds the new text (§8.1), so this is the one curation action that
            // needs Ollama up; the failure stays inline and the draft stays editable.
            await Browser.EditAsync(wisdomId, _draft, CancellationToken.None);
            _mode = DetailMode.Viewing;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Wisdom edit failed");
            _failure = (wisdomId, "The edit did not save: the new text must re-embed and persist. "
                + "Check the Health pill — Ollama and Postgres both have to be reachable.");
        }
        finally
        {
            _saving = false;
        }
    }

    // Both take the Wisdom whose row drew the button, never SelectedId: which of the two renders is
    // chosen by the on-screen record's RetiredAt, and in the window SelectedId already names a row
    // the curator has not seen — see ConfirmDelete.OnConfirm for that window. Retire is reversible
    // where Delete is not, but a reversal still has to be found first, on a record nobody knew was
    // touched.
    private Task RetireAsync(Guid wisdomId) => CurateAsync(
        wisdomId,
        () => Browser.RetireAsync(wisdomId, CancellationToken.None),
        "The retire did not land — Postgres has to be reachable. Check the Health pill.");

    private Task UnretireAsync(Guid wisdomId) => CurateAsync(
        wisdomId,
        () => Browser.UnretireAsync(wisdomId, CancellationToken.None),
        "The unretire did not land — Postgres has to be reachable. Check the Health pill.");

    /// <summary>
    /// The standing changes share the shape the edit already had: do it, re-read, and keep a
    /// transient failure inline. Unhandled, an exception out of a Blazor event handler takes the
    /// circuit down with it — the whole page reloads and the curator loses their place, over a
    /// blipped connection that a banner above a stale row would have ridden out.
    /// </summary>
    private async Task CurateAsync(Guid wisdomId, Func<Task> curate, string failure)
    {
        _failure = null;
        try
        {
            await curate();
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Wisdom curation failed");
            _failure = (wisdomId, failure);
        }
    }

    /// <summary>The failure to say above <paramref name="onScreen"/>, if it is that one's.</summary>
    private string? FailureFor(Guid onScreen)
        => _failure is { } failed && failed.Subject == onScreen ? failed.Text : null;

    /// <summary>
    /// Takes the Wisdom <see cref="ConfirmDelete.OnConfirm"/> named, never <see cref="SelectedId"/>
    /// — see that callback for the window the two disagree in.
    ///
    /// The navigation is conditional on them agreeing for the same reason. Deleting the Wisdom the
    /// route names leaves the route pointing at a dead record, so the surface has to leave; deleting
    /// the one still on screen after the curator clicked elsewhere does not, and navigating anyway
    /// would throw away the selection they just made. Either way the list has to be re-read, since
    /// nothing announces a Wisdom delete on the feed.
    /// </summary>
    private async Task DeleteAsync(Guid wisdomId)
    {
        _failure = null;
        try
        {
            await Browser.DeleteAsync(wisdomId, CancellationToken.None);
        }
        catch (Exception ex)
        {
            // Nothing was deleted, so the row is still there to try again on — say so and stay.
            Logger.LogWarning(ex, "Wisdom delete failed");
            _failure = (wisdomId, "The delete did not land — Postgres has to be reachable. "
                + "Check the Health pill; this Wisdom is untouched.");
            return;
        }

        if (SelectedId == wisdomId)
        {
            Nav.NavigateTo(ListHref);
            return;
        }

        await RefreshAsync();
    }

    public void Dispose()
    {
        Search.Changed -= OnSearchChanged;
        _claim?.Dispose();
        _debounce?.Dispose();
    }
}
