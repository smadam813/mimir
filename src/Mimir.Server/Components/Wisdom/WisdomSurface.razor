@using Mimir.Server.Storage.Entities
@using Mimir.Server.Ui
@implements IDisposable
@inject WisdomBrowser Browser
@inject ChassisBrowser Chassis
@inject SurfaceSearch Search
@inject NavigationManager Nav
@inject ILogger<WisdomSurface> Logger

<div class="wisdom-surface">
    <section class="list-pane" aria-label="Wisdom">
        <header class="list-head">
            <div class="list-title">
                <h4>@Words.Heading</h4>
                @if (_listing is { } counts)
                {
                    <span class="list-counts" title="This Project's own Wisdom plus Global — the set a session here recalls (§7)">
                        @if (IsGlobal)
                        {
                            <span>@counts.Global · Global</span>
                        }
                        else
                        {
                            <span>@counts.ProjectOwned · @ProjectName</span>
                            <span class="counts-join">+</span>
                            <span>@counts.Global · Global</span>
                        }
                    </span>
                }
            </div>

            @if (_listing is { } chips)
            {
                <div class="chips" role="group" aria-label="Filter by Kind">
                    <button type="button" class="btn btn-secondary chip @(_kind is null ? "is-active" : null)"
                            aria-pressed="@Pressed(_kind is null)" @onclick="() => SetKindAsync(null)">
                        All
                    </button>
                    @foreach (var chip in chips.Kinds)
                    {
                        <button type="button" class="btn btn-secondary chip @(_kind == chip.Kind ? "is-active" : null)"
                                aria-pressed="@Pressed(_kind == chip.Kind)"
                                @onclick="() => SetKindAsync(chip.Kind)">
                            @chip.Kind<span class="chip-count">@chip.Count</span>
                        </button>
                    }
                </div>
            }
        </header>

        <div class="list-rows">
            @if (_listing is { Entries.Count: 0 })
            {
                <p class="pane-note">@Words.Empty</p>
            }
            else if (_listing is { } listed)
            {
                @foreach (var entry in listed.Entries)
                {
                    <a @key="entry.Id" href="@DetailHref(entry.Id)"
                       class="wisdom-row @(entry.Id == SelectedId ? "is-selected" : null) @(entry.RetiredAt is not null ? "is-retired" : null)">
                        <span class="row-head">
                            <KindGlyph Kind="entry.Kind" />
                            <span class="row-kind">@entry.Kind</span>
                            <span class="row-scope" title="Scope (§3)">@entry.ScopeName</span>
                            @if (entry.ContestedAt is not null)
                            {
                                <span class="row-state state-accent">contested</span>
                            }
                            @if (entry.OrphanedProvenance)
                            {
                                <span class="row-state state-danger">orphaned</span>
                            }
                            @if (entry.RetiredAt is not null)
                            {
                                <span class="row-state">retired</span>
                            }
                            <span class="row-reinforcement" title="Reinforcement (§6)">×@entry.Reinforcement</span>
                        </span>
                        <span class="row-text">@entry.Text</span>
                    </a>
                }
            }
        </div>
    </section>

    <div class="pane-detail-frame">
        <div class="detail-column">
            <main class="detail-pane">
                @if (SelectedId is null)
                {
                    <p class="pane-note detail-empty">
                        Pick a Wisdom to read it, edit its words, or retire it. The list beside this is
                        everything a session in this repository recalls (§7).
                    </p>
                }
                else if (_detail is not { } detail)
                {
                    <p class="pane-note detail-empty">
                        Nothing lives at this id — most likely it was deleted with its chain (§10).
                        <a href="@ListHref">Back to the list</a>
                    </p>
                }
                else
                {
                    var entry = detail.Entry;

                    <div class="detail-head">
                        <span class="detail-kind"><KindGlyph Kind="entry.Kind" />@entry.Kind</span>
                        <span class="detail-sep">/</span>
                        <span class="detail-fact">scope <strong>@entry.ScopeName</strong></span>
                        @if (detail.FirstVersionAt is { } first)
                        {
                            <span class="detail-sep">/</span>
                            <span class="detail-fact">first written @EpisodeDisplay.Stamp(first)</span>
                        }
                    </div>

                    @if (entry.ContestedAt is { } contestedAt)
                    {
                        <p class="detail-state state-accent">
                            Contested since @EpisodeDisplay.Stamp(contestedAt) — it survived an adjudication
                            against a contradicting claim (§6.4).
                        </p>
                    }
                    @if (entry.RetiredAt is { } retiredAt)
                    {
                        <p class="detail-state">
                            Retired since @EpisodeDisplay.Stamp(retiredAt) — out of all recall and default
                            search, reversibly (§10). Its words stay editable, and an edit never unretires it.
                        </p>
                    }
                    @if (entry.SupersededBy is { } successor)
                    {
                        <p class="detail-state">
                            Superseded by <a href="@DetailHref(successor)">the ruling's survivor</a>.
                        </p>
                    }

                    @if (_mode is DetailMode.Editing)
                    {
                        <div class="text-head">
                            <h6 class="text-title is-editing">
                                The text · editing v@(detail.CurrentVersion) → v@(detail.CurrentVersion + 1)
                            </h6>
                            <span class="text-count">@WisdomDisplay.CharacterCount(_draft.Length)</span>
                        </div>
                        <textarea class="input detail-editor" @bind="_draft" @bind:event="oninput"
                                  aria-label="Edited Wisdom text"></textarea>
                        <div class="detail-actions">
                            <button class="btn btn-primary"
                                    disabled="@(_saving || WisdomDisplay.UnsavableReason(_draft, entry.Text) is not null)"
                                    @onclick="SaveAsync">
                                Save edit
                            </button>
                            <button class="btn btn-secondary" disabled="@_saving"
                                    @onclick="() => _mode = DetailMode.Viewing">Cancel</button>
                            @if (WisdomDisplay.UnsavableReason(_draft, entry.Text) is { } why)
                            {
                                <span class="detail-hint">@why</span>
                            }
                        </div>

                        <p class="edit-explains">
                            @WisdomDisplay.EditExplanation(detail.CurrentVersion + 1, entry.Reinforcement)
                        </p>
                    }
                    else
                    {
                        <p class="detail-text @(entry.RetiredAt is not null ? "is-retired" : null)">@entry.Text</p>
                        <div class="detail-actions">
                            <button class="btn btn-secondary" @onclick="() => BeginEdit(entry)">Edit</button>
                            @if (entry.RetiredAt is null)
                            {
                                <button class="btn btn-secondary"
                                        title="Reversibly exclude from recall and default search (§10)"
                                        @onclick="() => RetireAsync(entry.Id)">
                                    Retire
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-secondary" @onclick="() => UnretireAsync(entry.Id)">Unretire</button>
                            }
                            <span class="detail-hint">@WisdomDisplay.RetireHint(entry.RetiredAt is not null)</span>
                        </div>
                    }
                    @if (FailureFor(entry.Id) is { } failure)
                    {
                        <p class="pane-error" role="alert">@failure</p>
                    }

                    <div class="chain-head">
                        <h5 class="detail-section">
                            Version chain
                            <span class="version-total">@WisdomDisplay.VersionCount(detail.Versions.Count)</span>
                        </h5>
                        <span class="chain-toggle" role="group" aria-label="How the version chain reads">
                            <button type="button" class="chain-view @(_chainView is VersionChainView.Changed ? "is-active" : null)"
                                    aria-pressed="@Pressed(_chainView is VersionChainView.Changed)"
                                    @onclick="() => _chainView = VersionChainView.Changed">
                                What changed
                            </button>
                            <button type="button" class="chain-view @(_chainView is VersionChainView.Full ? "is-active" : null)"
                                    aria-pressed="@Pressed(_chainView is VersionChainView.Full)"
                                    @onclick="() => _chainView = VersionChainView.Full">
                                Full text
                            </button>
                        </span>
                    </div>
                    <ol class="version-list">
                        @foreach (var version in WisdomDisplay.WithPendingEdit(
                            _chain, entry.Text, _mode is DetailMode.Editing ? _draft : null))
                        {
                            @* Keyed because this is the one list on the surface that grows at its
                               head, where positional patching would re-render every row below. *@
                            <li @key="version.Version"
                                class="version-row @(version.Pending ? "is-pending" : null)">
                                <span class="version-rail" aria-hidden="true">
                                    <i class="version-dot"></i>
                                    <i class="version-line"></i>
                                </span>
                                <div class="version-body">
                                    <div class="version-meta">
                                        <span class="version-seq">v@(version.Version)</span>
                                        <span class="version-cause">
                                            @WisdomDisplay.CauseWord(version.Cause)@(version.Pending ? " · unsaved" : null)
                                        </span>
                                        @if (version.At is { } at)
                                        {
                                            <span class="version-at">@EpisodeDisplay.Stamp(at)</span>
                                        }
                                        @if (_chainView is VersionChainView.Full)
                                        {
                                            <span class="version-chars">
                                                @WisdomDisplay.CharacterCount(version.Text.Length)
                                            </span>
                                        }
                                    </div>
                                    @if (_chainView is VersionChainView.Changed)
                                    {
                                        @* role= spells out each element's own implicit role, which
                                           browsers largely do not expose to a screen reader. *@
                                        <p class="version-text">@foreach (var run in version.Changed)
                                            {
                                                @if (run.Change is TextChange.Removed)
                                                {
                                                    <del role="deletion">@run.Text</del>
                                                }
                                                else if (run.Change is TextChange.Added)
                                                {
                                                    <ins role="insertion">@run.Text</ins>
                                                }
                                                else
                                                {
                                                    @run.Text
                                                }
                                            }</p>
                                    }
                                    else
                                    {
                                        <p class="version-text is-full">@version.Text</p>
                                    }
                                    @if (version.Pending)
                                    {
                                        <p class="version-note">
                                            Not yet through the Merge Gate — nothing recalls this
                                            wording until you save.
                                        </p>
                                    }
                                </div>
                            </li>
                        }
                    </ol>

                    @if (_mode is not DetailMode.Editing)
                    {
                        <div class="pane-danger">
                            <ConfirmDelete Label="Delete Wisdom…" SubjectKey="detail.Entry.Id"
                                           Prompt="@($"Hard-delete this Wisdom and its {detail.Versions.Count}-version chain forever? Nothing reverses this.")"
                                           OnConfirm="DeleteAsync" />
                        </div>
                    }
                }
            </main>

            @if (SelectedId is not null && _detail is not null)
            {
                <footer class="cause-legend">
                    <p>
                        @foreach (var gloss in WisdomDisplay.CauseLegend)
                        {
                            @* The trailing space rides inside the expression because Razor trims
                               literal whitespace between elements. *@
                            <b>@gloss.Word</b>@($" — {gloss.Meaning} ")
                        }
                    </p>
                </footer>
            }
        </div>

        @if (_detail is { } aside)
        {
            <aside class="pane-aside">
                <div>
                    <h6>Reinforcement</h6>
                    <div class="aside-figure">
                        <span class="aside-figure-value">@aside.Entry.Reinforcement.ToString("N0")</span>
                        <span class="aside-figure-unit">
                            @WisdomDisplay.ReinforcementUnit(aside.Entry.Reinforcement)
                        </span>
                    </div>
                    <div class="reinforcement-bar" aria-hidden="true">
                        @for (var segment = 0; segment < WisdomDisplay.ReinforcementBarSegments; segment++)
                        {
                            <i class="@(segment < WisdomDisplay.ReinforcementFilled(aside.Entry.Reinforcement)
                                        ? "is-lit" : null)"></i>
                        }
                    </div>
                    <p class="aside-note">
                        last confirmed @EpisodeDisplay.Stamp(aside.Entry.LastConfirmedAt) — an
                        Admission moves this, an edit does not (§6).
                    </p>
                </div>

                <div>
                    <h6>Recall</h6>
                    <dl class="aside-rows">
                        @foreach (var lane in aside.Recall.Lanes)
                        {
                            <dt @key="lane.Lane">@InjectionDisplay.Name(lane.Lane) lane</dt>
                            <dd class="is-strong">@lane.Entries.ToString("N0")</dd>
                        }
                        <dt>Marked useful</dt><dd class="is-accent">@aside.Recall.MarkedUseful.ToString("N0")</dd>
                        <dt>Marked noise</dt><dd>@aside.Recall.MarkedNoise.ToString("N0")</dd>
                    </dl>
                    <p class="aside-note">@WisdomDisplay.RecallNote(aside.Recall)</p>
                </div>

                <div>
                    <div class="aside-head">
                        <h6>Where this came from</h6>
                        <span class="aside-head-count">@aside.Provenance.Count</span>
                    </div>
                    @if (aside.Entry.OrphanedProvenance)
                    {
                        <p class="aside-orphaned">
                            Orphaned: every Episode, Event and Harvested Item this Wisdom derived
                            from was deleted, and the cascade took the links with them (§3). The
                            words and the version chain survive; only the trail back is gone, and
                            nothing reverses it.
                        </p>
                    }
                    else
                    {
                        <div class="aside-links">
                            @foreach (var link in aside.Provenance)
                            {
                                @if (link.EpisodeId is not null)
                                {
                                    <a class="aside-link" @key="link.Id" href="@EpisodeHref(link)">
                                        <span class="aside-link-title">@WisdomDisplay.ProvenanceTitle(link)</span>
                                        <span class="aside-link-detail">@WisdomDisplay.ProvenanceDetail(link)</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="aside-link" @key="link.Id">
                                        <span class="aside-link-title">@WisdomDisplay.ProvenanceTitle(link)</span>
                                        <span class="aside-link-detail">@WisdomDisplay.ProvenanceDetail(link)</span>
                                    </span>
                                }
                            }
                        </div>
                        @if (WisdomDisplay.ProvenanceNote(aside.Provenance) is { } promise)
                        {
                            <p class="aside-note">@promise</p>
                        }
                    }
                </div>
            </aside>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Guid ProjectId { get; set; }

    [Parameter]
    public Guid? SelectedId { get; set; }

    [Parameter]
    public WisdomLens Lens { get; set; }

    private enum DetailMode { Viewing, Editing }

    private WisdomListing? _listing;
    private WisdomDetail? _detail;

    // Diffed once when the detail is read, not per render, and assigned with it.
    private IReadOnlyList<VersionEntry> _chain = [];
    private Guid? _boundSelection;
    private Guid _boundProject;
    private WisdomKind? _kind;
    private ProjectListItem? _project;

    private DetailMode _mode;
    private bool _saving;
    private string _draft = "";
    private (Guid Subject, string Text)? _failure;

    // Stated rather than left to the enum's declaration order: which view the chain opens on is
    // not pinned anywhere — the render test switches views and asserts on the switch (#134).
    private VersionChainView _chainView = VersionChainView.Changed;

    private IDisposable? _claim;
    private Debouncer? _debounce;
    private int _generation;

    private string ProjectName => _project?.DisplayName ?? "this Project";

    private bool IsGlobal => _project?.IsGlobal ?? false;

    private string ListHref => WisdomRoute.Listing(ProjectId, Lens);

    private string DetailHref(Guid wisdomId) => WisdomRoute.Detail(ProjectId, wisdomId, Lens);

    private static string EpisodeHref(ProvenanceEntry link)
        => $"projects/{link.EpisodeProjectId}/episodes/{link.EpisodeId}"
            + (link.EventId is { } eventId ? EpisodeDisplay.EventAnchorHref(eventId) : "");

    private (string Heading, string Empty) Words => Lens switch
    {
        WisdomLens.Contested => ("Contested",
            "Nothing is contested here — no adjudication has ruled against a standing claim in "
            + "the last fortnight (§6.4)."),
        WisdomLens.Orphaned => ("Orphaned",
            "Nothing is orphaned here: every Wisdom in this universe still has the trail back to "
            + "what it came from (§3)."),
        WisdomLens.Retired => ("Retired", "Nothing has been retired here yet (§10)."),
        _ => ("Wisdom",
            "No Wisdom matches. The Merge Gate fills this surface as Episodes distill and Harvest "
            + "runs (§6) — or the search and chips above are simply this narrow."),
    };

    protected override void OnInitialized()
    {
        _debounce = new Debouncer(Debouncer.DefaultDelay, Logger, "Wisdom listing refresh");

        // Claimed before subscribing, so the claim's own reset does not schedule a query the first
        // load already does.
        AnchorOnProject();
        Search.Changed += OnSearchChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_boundSelection != SelectedId)
        {
            _boundSelection = SelectedId;
            _mode = DetailMode.Viewing;
            _failure = null;
        }

        if (_boundProject != ProjectId)
        {
            AnchorOnProject();
        }

        await RefreshAsync();
    }

    private void AnchorOnProject()
    {
        _boundProject = ProjectId;
        _kind = null;
        _project = null;
        _claim?.Dispose();
        _claim = Search.Claim(this, "Search this Project's Wisdom…");
    }

    // A string, not a bool: a bool renders as a present-or-absent attribute, which is not what
    // aria-pressed means.
    private static string Pressed(bool active) => active ? "true" : "false";

    private void OnSearchChanged()
        => _debounce?.Schedule(() => InvokeAsync(() => RefreshAsync(reloadDetail: false)));

    private Task RefreshAsync() => RefreshAsync(reloadDetail: true);

    private async Task RefreshAsync(bool reloadDetail)
    {
        var generation = ++_generation;

        var project = _project ?? await Chassis.GetProjectAsync(ProjectId, CancellationToken.None);
        var listing = await Browser.ListAsync(
            new WisdomQuery(ProjectId, Search.Term, _kind, Lens), CancellationToken.None);
        var detail = reloadDetail && SelectedId is { } selected
            ? await Browser.GetAsync(selected, CancellationToken.None)
            : null;

        if (generation != _generation)
        {
            return;
        }

        _project = project;
        _listing = listing;

        if (reloadDetail)
        {
            _detail = detail;
            _chain = detail is null ? [] : WisdomDisplay.Chain(detail.Versions);
        }

        StateHasChanged();
    }

    private async Task SetKindAsync(WisdomKind? kind)
    {
        _kind = kind;
        await RefreshAsync(reloadDetail: false);
    }

    private void BeginEdit(WisdomListEntry entry)
    {
        _draft = entry.Text;
        _failure = null;
        _mode = DetailMode.Editing;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _failure = null;

        // The one action that may read SelectedId: the selection reset above drops the editor
        // before the window opens, so it is only ever open while the two still agree.
        var wisdomId = SelectedId!.Value;
        try
        {
            await Browser.EditAsync(wisdomId, _draft, CancellationToken.None);
            _mode = DetailMode.Viewing;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Wisdom edit failed");
            _failure = (wisdomId, "The edit did not save: the new text must re-embed and persist. "
                + "Check the Health pill — Ollama and Postgres both have to be reachable.");
        }
        finally
        {
            _saving = false;
        }
    }

    private Task RetireAsync(Guid wisdomId) => CurateAsync(
        wisdomId,
        () => Browser.RetireAsync(wisdomId, CancellationToken.None),
        "The retire did not land — Postgres has to be reachable. Check the Health pill.");

    private Task UnretireAsync(Guid wisdomId) => CurateAsync(
        wisdomId,
        () => Browser.UnretireAsync(wisdomId, CancellationToken.None),
        "The unretire did not land — Postgres has to be reachable. Check the Health pill.");

    private async Task CurateAsync(Guid wisdomId, Func<Task> curate, string failure)
    {
        _failure = null;
        try
        {
            await curate();
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            // Swallowed and said inline: unhandled, an exception out of a Blazor event handler
            // takes the circuit down and the curator loses their place.
            Logger.LogWarning(ex, "Wisdom curation failed");
            _failure = (wisdomId, failure);
        }
    }

    private string? FailureFor(Guid onScreen)
        => _failure is { } failed && failed.Subject == onScreen ? failed.Text : null;

    private async Task DeleteAsync(Guid wisdomId)
    {
        _failure = null;
        try
        {
            await Browser.DeleteAsync(wisdomId, CancellationToken.None);
        }
        catch (Exception ex)
        {
            // Swallowed and said inline: nothing was deleted, so the row is still there to retry on.
            Logger.LogWarning(ex, "Wisdom delete failed");
            _failure = (wisdomId, "The delete did not land — Postgres has to be reachable. "
                + "Check the Health pill; this Wisdom is untouched.");
            return;
        }

        if (SelectedId == wisdomId)
        {
            Nav.NavigateTo(ListHref);
            return;
        }

        await RefreshAsync();
    }

    public void Dispose()
    {
        Search.Changed -= OnSearchChanged;
        _claim?.Dispose();
        _debounce?.Dispose();
    }
}
