<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="bunit" />
    <!-- Lifts bUnit's transitive AngleSharp past GHSA-pgww-w46g-26qg; see Directory.Packages.props. -->
    <PackageReference Include="AngleSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- AppSettingsTests asserts the shipped config still matches the §11 defaults in code. -->
    <Content Include="..\..\src\Mimir.Server\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- OfflineAssetsTests scans every shipped stylesheet for a remote reference. -->
    <Content Include="..\..\src\Mimir.Server\wwwroot\**\*.css" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" />
    <!-- SurfaceChassisTests reads the scoped stylesheets against the token layer they hoisted into. -->
    <Content Include="..\..\src\Mimir.Server\Components\**\*.razor.css" LinkBase="Components" CopyToOutputDirectory="PreserveNewest" />
    <!-- FirstRunCommandsTests asserts the README still states the registrations the app hands out. -->
    <Content Include="..\..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mimir.Server\Mimir.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
