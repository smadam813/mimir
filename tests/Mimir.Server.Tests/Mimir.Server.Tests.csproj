<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- AppSettingsTests asserts the shipped config still matches the §11 defaults in code. -->
    <Content Include="..\..\src\Mimir.Server\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- OfflineAssetsTests scans every shipped stylesheet for a remote reference. -->
    <Content Include="..\..\src\Mimir.Server\wwwroot\**\*.css" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" />
    <!-- LegacySurfaceTests checks every un-ported page still wraps itself for the unpadded body. -->
    <Content Include="..\..\src\Mimir.Server\Components\Pages\**\*.razor" LinkBase="Components\Pages" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mimir.Server\Mimir.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
